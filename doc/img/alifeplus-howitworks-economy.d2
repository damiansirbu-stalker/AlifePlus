direction: down

style.fill: "#1f2421"

**.style.fill: "#262c27"
**.style.stroke: "#ece7d8"
**.style.font-color: "#ece7d8"
**.style.stroke-width: 2

title: "AlifePlus - a closed economy and a world that reshapes" {
  near: top-center
  style: { stroke-width: 0; fill: "#1f2421"; font-color: "#ece7d8"; font-size: 28 }
}

driver: "The same pipeline, other consequences" {
  style.stroke: "#c9d8b6"
  grid-columns: 1
  grid-gap: 12
  a: "needs and reactions fire trade, loot, territory, and alphas"
  b: "items and money only move, never invented"
}

econ: "Emergent economy" {
  style.stroke: "#c9d8b6"
  grid-columns: 2
  grid-gap: 14
  trade:  "Supply Trader\nan NPC sells surplus, buys up to its rank band, capped on profit"
  barter: "Barter\ntwo NPCs swap surplus for need plus a gear upgrade, no money"
  market: "Faction Market\nthe NPC trade surfaces as stock and prices at a faction hub"
  loot:   "Corpse Loot\nthe killer owns the body, the looter keeps a value-ranked share"
}

money: "Money matches vanilla - half an item's cost to sell surplus, full cost to buy a need"

world: "The world reshapes" {
  style.stroke: "#c9d8b6"
  grid-columns: 1
  grid-gap: 12
  terr:  "Territory\na faction takes a smart and grows a mini base of service NPCs and guards, taken once and kept"
  swarm: "Swarm and infestation\nmutants flood or seed a smart"
  alpha: "Alphas\na mutant that kills enough is promoted - scaled damage dealt and taken, panic-immune, trophy loot, a visible mark"
}

driver -> econ: "trade" { style: { stroke: "#c9d8b6"; font-color: "#c9d8b6" } }
econ -> money: "" { style: { stroke: "#c9d8b6" } }
driver -> world: "mutate" { style: { stroke: "#c9d8b6"; font-color: "#c9d8b6" } }
