; AlifePlus trade policy, in the visiting stalker's view: min = he buys up to, max = he sells above, one inventory band per key (ap_market_policy.ltx is the trader's view).
; Two tiers split by RANK_VETERAN (12000, per ap_core_const). Entry order in a block is buy priority (top fills first, stop when cash runs out). Ammo counts in rounds, items otherwise.
; Combat ammo: buy floor 1 box (15 rifle / 16 pistol), sell ceiling the 3-box cap (45 / 48), so trade tops a short NPC up but never sells the boxes it looted. Rookies buy no AP.
; A key is a category or a single item section; an item uses its section rule when listed, else its category rule, and an unmatched item is left alone. Sell-only keys use min 0, max 0
; (count below 0 never triggers a buy): weapon, outfit, and helmet are sell-only, so an NPC clears surplus gear (the sale releases it, see ap_ext_trade) and never buys gear back.
; These rows govern NPC inventory only, not the player's buy menu; gear never reaches the player's shelf through trading, so deleting them only makes NPCs hoard surplus weapons.
; Grenades are listed individually so smoke (grenade_smoke) can be left out; trade never moves it (engine crash on NPC throw) and the standing-loadout cull purges it from NPCs.
; Untouchable and equipped items are pre-filtered and never reach this policy.

[ap_trade_policy_rookie]
ammo_slot_3_t1    = 15, 45
ammo_slot_2_t1    = 16, 48
ammo_slot_3_t2    = 0, 45
ammo_slot_2_t2    = 0, 48
ammo_not_equipped = 0, 0
grenade_f1        = 0, 0
grenade_rgd5      = 0, 0
grenade_gd-05     = 0, 0
grenade_ammo      = 0, 0
medkit            = 1, 3
bandage           = 1, 3
stim              = 0, 1
antirad           = 1, 2
pill              = 0, 2
food              = 1, 2
drink             = 1, 2
weapon            = 0, 0
outfit            = 0, 0
helmet            = 0, 0
artefact          = 0, 1
device            = 0, 0
; Carried gear an NPC keeps rather than trades away: one artefact, one binoculars, one NVG stay
; on the body, everything above that moves normally. The section rows exist because binoculars
; classify as "weapon" and night-vision torches as "device", both sell-only categories, so
; without their own row they would always be cleared.
wpn_binoc         = 0, 1
device_torch_nv_1 = 0, 1
device_torch_nv_2 = 0, 1
device_torch_nv_3 = 0, 1
; Armour plates an NPC keeps rather than sells: same carve-out reason as binoc/NVG.
af_kevlar         = 0, 1
af_plates         = 0, 1
af_kevlar_up      = 0, 1
af_plates_up      = 0, 1
fieldcraft_plate_attch = 0, 1
money             = 0, 0
crafting          = 0, 0
other             = 0, 0

