; AlifePlus barter policy. NPC-to-NPC item swap, no money; ap_trade_policy.ltx is the stalker-vs-trader cash version. One uniform block, no rank tiers. DLTX-overridable.
;
; Same category system as trade: keys are engine-derived (xinventory.get_category / get_category_opts resolves ammo_slot_2/3_tN per the NPC's equipped pistol/rifle, ammo_not_equipped,
; grenades, medical/food/drink). Each row is a category band in the holder's view: min = keep at least this many, max = give away above this. An item moves from A to B when A holds it
; above A's max and B holds it below B's min. Ammo counts in rounds, items otherwise. Items moved per event are capped by MCM barter_max_items (Economy > barter).
;
; Weapons, outfits, and helmets are not count-band rows; the barter orchestrator upgrades them on a separate cost pass (a spare moves only when its get_cost beats the receiver's equipped
; one), so they are absent here. Untouchable and equipped items are dropped by xinventory.get_category before any policy lookup.

[ap_barter_policy]
ammo_slot_3_t1    = 15, 45
ammo_slot_2_t1    = 16, 48
ammo_slot_3_t2    = 15, 45
ammo_slot_2_t2    = 16, 48
ammo_not_equipped = 0, 0
grenade_f1        = 1, 3
grenade_rgd5      = 1, 3
grenade_gd-05     = 1, 3
grenade_ammo      = 0, 0
medkit            = 1, 3
bandage           = 1, 4
stim              = 0, 2
antirad           = 1, 2
pill              = 0, 3
food              = 1, 2
drink             = 1, 2
artefact          = 0, 1
device            = 0, 0
; Carried gear an NPC keeps rather than trades away: one artefact, one binoculars, one NVG stay
; on the body, everything above that moves normally. The section rows exist because binoculars
; classify as "weapon" and night-vision torches as "device", both sell-only categories, so
; without their own row they would always be cleared.
wpn_binoc         = 0, 1
device_torch_nv_1 = 0, 1
device_torch_nv_2 = 0, 1
device_torch_nv_3 = 0, 1
; Armour plates an NPC keeps rather than bartering away: same carve-out reason as binoc/NVG.
af_kevlar         = 0, 1
af_plates         = 0, 1
af_kevlar_up      = 0, 1
af_plates_up      = 0, 1
fieldcraft_plate_attch = 0, 1
crafting          = 0, 3
other             = 0, 0
