; AlifePlus stash policy. Single uniform block (no per-rank). DLTX-overridable.
; Loot flow: for each category, take from stash if squad_count < min, up to min.
; Fill flow: for each category, deposit to stash if squad_count > max, total per event capped by fill_max.
; extras_max: after category-based loot, take top-N additional items from stash by `cost` field.
; Quest / untouchable sections in stash -> whole stash skipped (no loot, no clear). Hardcoded.
; Toolkit-containing stashes -> whole stash skipped only when MCM consequence_stash_loot_skip_crafting on.
; Sell-only categories use 0, 0 (never lootable to squad, never deposited to stash).
; A row key is either a category or a single item section; an item unlisted by any row is left
; alone (never looted, never deposited). Grenades are listed individually so smoke (grenade_smoke)
; is simply left out -- it never enters or leaves a stash (engine crash on NPC throw).

[ap_stash_policy]
ammo_slot_3_t1    = 15, 45
ammo_slot_2_t1    = 16, 48
ammo_slot_3_t2    = 0, 0
ammo_slot_2_t2    = 0, 0
ammo_not_equipped = 0, 0
grenade_f1        = 0, 3
grenade_rgd5      = 0, 3
grenade_gd-05     = 0, 3
grenade_ammo      = 0, 2
medkit            = 2, 3
bandage           = 0, 3
stim              = 0, 2
antirad           = 0, 3
pill              = 0, 3
food              = 0, 3
drink             = 0, 2
weapon            = 0, 0
outfit            = 0, 0
helmet            = 0, 0
artefact          = 0, 1
device            = 0, 0
; Carried gear an NPC keeps rather than trades away: one artefact, one binoculars, one NVG stay
; on the body, everything above that moves normally. The section rows exist because binoculars
; classify as "weapon" and night-vision torches as "device", both sell-only categories, so
; without their own row they would always be cleared.
wpn_binoc         = 0, 1
device_torch_nv_1 = 0, 1
device_torch_nv_2 = 0, 1
device_torch_nv_3 = 0, 1
; Armour plates an NPC keeps rather than stashing: same carve-out reason as binoc/NVG.
af_kevlar         = 0, 1
af_plates         = 0, 1
af_kevlar_up      = 0, 1
af_plates_up      = 0, 1
fieldcraft_plate_attch = 0, 1
money             = 0, 0
crafting          = 0, 0
other             = 0, 0
extras_max        = 2
fill_max          = 3
