grenade_ammo         = 0
grenade              = 0
medkit               = 1
bandage              = 2
antirad              = 2
stim                 = 2
pill                 = 3
food                 = 16
drink                = 13
crafting             = 0
weapon               = 0
outfit               = 0
helmet               = 0
artefact             = 0
device               = 0
other                = 0

