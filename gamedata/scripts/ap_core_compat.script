--- ap_core_compat: Save data migrations and proxy registrations for external mods
local pairs, type, tostring, RegisterScriptCallback = pairs, type, tostring, RegisterScriptCallback
local xobject, xsquad, xchange = xobject, xsquad, xchange
local ap_core_debug, ap_core_broker = ap_core_debug, ap_core_broker
local CALLBACK = ap_core_const.CALLBACK

local _to_remove = {}
local _pending_release = {}
local _pending_remove = {}
local _purge_services_pending = false

-- Queue a squad id for engine-side release at on_game_load.
-- load_state runs before objects().load() (alife_storage_manager.cpp:141), so
-- xobject.se returns nil and xsquad.release_squad would no-op. Drained post-STATE_Read.
local function _queue_release(squad_id)
    if type(squad_id) ~= "number" then return end
    _pending_release[#_pending_release + 1] = squad_id
end

-- Queue a squad for engine-side removal (delete, not release). Same timing as _queue_release.
-- The section travels with the id: freed server ids are pooled and reused
-- (xrServer.cpp:873 vfFreeID), so a hold entry written before its squad died can name an id that now
-- belongs to something else, and the drain compares the section before deleting anything.
local function _queue_remove(squad_id, section)
    if type(squad_id) ~= "number" then return end
    _pending_remove[#_pending_remove + 1] = { id = squad_id, section = section }
end

-- Empty one outpost's service set in place.
local function _clear_services(services)
    for k = 1, #_to_remove do _to_remove[k] = nil end
    for role in pairs(services) do _to_remove[#_to_remove + 1] = role end
    for i = 1, #_to_remove do services[_to_remove[i]] = nil end
end

-- Drop every service hold and queue its squad for removal; guard holds stay (they are combat squads,
-- not services, and the outpost keeps its detail).
local function _clear_service_holds(holds)
    for k = 1, #_to_remove do _to_remove[k] = nil end
    for squad_id, entry in pairs(holds) do
        if type(entry) == "table" and entry.role and entry.role ~= "guard" then
            _queue_remove(squad_id, entry.section)
            _to_remove[#_to_remove + 1] = squad_id
        end
    end
    for i = 1, #_to_remove do holds[_to_remove[i]] = nil end
end

--- v1.8.5 -> v1.8.6: delete every outpost service a pre-1.8.6 save carries, and let growth rebuild
--- them under the current rules. The one-service-per-outpost rule guards growth only, so a save
--- written before it keeps every role it grew: field logs show outposts holding trader, barman and
--- mechanic at once, standing in a rank, with one outpost eating its whole level budget so no other
--- outpost on that map can ever grow a service. Keeping one of the three would carry a legacy NPC's
--- stock, trade config and spot forward and pick an arbitrary survivor, so all of them go and the
--- next growth roll seats a fresh service at the corrected spot geometry.
--- Empties the service sets and drops the service holds; the squads themselves go at on_game_load,
--- the documented safe mutation point -- entities registered, no update tick yet
--- (doc/library/modding/script-loading.md:425-455). load_state is too early for that: it runs before
--- objects().load (alife_storage_manager.cpp:141), so no server entity exists.
--- Mutates both tables IN PLACE: ap_ext_smart_mutator captures them by reference at its own
--- load_state and dispatch order is nondeterministic (axr_main.script:272), so a parent-key nil
--- could be missed if the mutator's load_state ran first.
local function _v185_to_v186_clear_outpost_services(m_data)
    local saved = m_data.ap_ext_smart_mutator
    local conquest = (type(saved) == "table") and saved.conquered_smarts or nil
    if type(conquest) == "table" then
        for _, data in pairs(conquest) do
            local services = (type(data) == "table") and data.services or nil
            if type(services) == "table" then _clear_services(services) end
        end
    end
    local holds = m_data.ap_ext_smart_mutator_holds
    if type(holds) == "table" then _clear_service_holds(holds) end
end

--- v1.8.6 -> v1.8.7: outpost mini-base redesign (plan rows + pin; no spot job, no visuals, no
--- respawn-pacing writes). ONE migration from the last released version (1.8.6); the never-shipped
--- intermediate dev stamps are folded in. Resets every conquest entry's outpost state -- services
--- cleared and the plan marker (guards) dropped, so the mutator rolls a FRESH plan under the current
--- MCM sliders for each legacy held smart at restore. Service holds drop with their squads. Old
--- pinned-guard holds (the retired forced-stay garrison) drop too and their squads are queued for
--- RELEASE (they were ordinary conquest spawns, so clearing the pin returns them to the sim). Then
--- arms the world purge of every outpost-service NPC still standing -- an ap_service_ squad, or a
--- squadless sim_default_<faction>_<role> orphan -- drained by _drain_outpost_services at
--- on_game_load, where the live squads exist. Growth reseats a fresh one under the new rules.
-- Reset one saved conquest entry's outpost state: services cleared, plan marker + dead field dropped.
local function _reset_saved_plan(data)
    if type(data) ~= "table" then return end
    if type(data.services) == "table" then _clear_services(data.services) end
    data.guards = nil
    data.respawn_idle_base = nil
end

-- Drop the old pinned-guard holds and queue their squads for release back to the sim.
local function _release_saved_guard_holds(holds)
    for k = 1, #_to_remove do _to_remove[k] = nil end
    for squad_id, entry in pairs(holds) do
        if type(entry) == "table" and entry.role == "guard" then
            _queue_release(squad_id)
            _to_remove[#_to_remove + 1] = squad_id
        end
    end
    for i = 1, #_to_remove do holds[_to_remove[i]] = nil end
end

local function _v186_to_v187_reset_outposts(m_data)
    local saved = m_data.ap_ext_smart_mutator
    local conquest = (type(saved) == "table") and saved.conquered_smarts or nil
    if type(conquest) == "table" then
        for _, data in pairs(conquest) do _reset_saved_plan(data) end
    end
    local holds = m_data.ap_ext_smart_mutator_holds
    if type(holds) == "table" then
        _clear_service_holds(holds)
        _release_saved_guard_holds(holds)
    end
    _purge_services_pending = true
end

xchange.register("ap_v185_to_v186_clear_outpost_services", _v185_to_v186_clear_outpost_services)
xchange.register("ap_v186_to_v187_reset_outposts",         _v186_to_v187_reset_outposts)

--- Run all registered changesets on load_state. m_data only; no engine state.
local function _on_load_state(m_data)
    if not m_data then return end
    xchange.run(m_data)
end

-- Drain queued orphan releases.
local function _drain_releases()
    if #_pending_release == 0 then return end
    local count = 0
    for i = 1, #_pending_release do
        local squad = xobject.se(_pending_release[i])
        if squad then
            xsquad.release_squad(squad)
            count = count + 1
        end
        _pending_release[i] = nil
    end
    if ap_core_debug.enabled() then
        ap_core_debug.debug("[COMPAT] release_orphaned: released=%d", count)
    end
end

-- Identity guard for a queued removal: the live squad must still carry the section pinned when the
-- hold was written. Entries saved before the section was recorded skip the compare.
local function _same_section(squad, section)
    if not section then return true end
    return squad:section_name() == section
end

-- Drain queued removals. Each member's PDA trade spot goes first: the icon is added by the engine
-- from the job's `level_spot` key (stalker_generic.update_level_spot) and vanilla only clears it on
-- death, so a removal that skips it leaves the icon on the map at a dissolved post.
-- A queued removal runs once per save and deletes a live NPC, so it reports per squad, not just a
-- total: a bare count cannot tell a removal from a skip, and a skip is what a recycled id looks like.
local function _drain_removals()
    if #_pending_remove == 0 then return end
    local debug_on = ap_core_debug.enabled()
    local count, skipped = 0, 0
    for i = 1, #_pending_remove do
        local queued = _pending_remove[i]
        local squad = xobject.se(queued.id)
        if squad and xsquad.is_squad(squad) and _same_section(squad, queued.section) then
            for member_id in xsquad.iter_member_ids(squad) do
                stalker_generic.remove_level_spot(member_id)
            end
            xsquad.remove_squad(squad)
            count = count + 1
            if debug_on then
                ap_core_debug.debug("[COMPAT] remove_queued: squad=%d section=%s removed",
                    queued.id, tostring(queued.section))
            end
        else
            skipped = skipped + 1
            if debug_on then
                ap_core_debug.debug("[COMPAT] remove_queued: squad=%d section=%s SKIPPED (%s)",
                    queued.id, tostring(queued.section),
                    squad and "identity mismatch" or "entity gone")
            end
        end
        _pending_remove[i] = nil
    end
    if debug_on then
        ap_core_debug.debug("[COMPAT] remove_queued: removed=%d skipped=%d", count, skipped)
    end
end

-- Service ROLE from a sim_default profile section ("sim_default_stalker_trader" -> "trader"),
-- nil for every other section. The NPC-level identity of an outpost service: the profile persists
-- on the server entity for life, squad or no squad.
local _SERVICE_ROLES = { trader = true, barman = true, mechanic = true, medic = true }
local function _service_profile_role(sec)
    local role = sec and sec:match("^sim_default_%a+_(%a+)$")
    return (role and _SERVICE_ROLES[role]) and role or nil
end

--- Purge every outpost-service NPC in the world, by BOTH identities (see the _v186_to_v187 and
--- _v188 changesets). Squad identity: an ap_service_ squad section is AlifePlus-only, so every
--- such squad is queued for removal, tracked or not. NPC identity: a stalker wearing a
--- sim_default_<faction>_<role> service profile with NO resolving squad is an ORPHAN leftover --
--- old builds could delete a service squad out from under its member, and a squadless NPC is
--- invisible to the squad sweep, standing or wandering forever (field, 2026-08-01: an orphaned
--- trader walked Cordon and survived every purge). Vanilla story mode never leaves sim_default
--- service profiles squadless, so an orphan match is ours by construction; squadded foreign
--- sim_default NPCs are untouched. One pass over the server-object pool at load (once per save
--- lineage, the changeset gates it), then the queues drain in the same on_game_load pass.
--- @cost O(CSE pool) one-shot walk + O(services) queue | migration-only, never a per-session cost
-- Collector for one CSE: append a squadless service NPC's id to `orphans`. An NPC whose group_id
-- resolves to a live squad is left to the squad sweep.
local function _collect_orphan_service(se, orphans)
    if not _service_profile_role(se.section_name and se:section_name()) then return end
    local squad = xsquad.get_squad_by_member(se.id)
    if squad and xsquad.is_squad(squad) then return end
    orphans[#orphans + 1] = se.id
end

-- Release one collected orphan by id (PDA spot first), logging per NPC when debug is on.
local function _release_orphan_service(sim, npc_id, debug_on)
    local se = xobject.se(npc_id)
    if not se then return 0 end
    stalker_generic.remove_level_spot(npc_id)
    sim:release(se, true)
    if debug_on then
        ap_core_debug.debug("[COMPAT] orphan_service_released: npc=%d", npc_id)
    end
    return 1
end

local function _drain_outpost_services()
    local sim = alife()
    if not sim then return end
    for squad in xsquad.iter_squads() do
        local sec = squad.section_name and squad:section_name()
        if sec and sec:sub(1, 11) == "ap_service_" then _queue_remove(squad.id) end
    end
    local orphans = {}
    sim:iterate_objects(function(se) _collect_orphan_service(se, orphans) end)
    local debug_on = ap_core_debug.enabled()
    local released = 0
    for i = 1, #orphans do
        released = released + _release_orphan_service(sim, orphans[i], debug_on)
    end
    if released > 0 then
        ap_core_debug.warn("[COMPAT] orphan_service_purge: released=%d squadless service NPCs", released)
    end
end

--- Drain queued engine-side work. on_game_load is the documented safe mutation point: entities are
--- registered and no update tick has run yet (doc/library/modding/script-loading.md:425-455). The
--- orphan-service sweep queues into the same removal list before the drain, so one pass deletes both
--- the changeset-queued removals and the orphans.
local function _on_game_load()
    _drain_releases()
    if _purge_services_pending then _purge_services_pending = false; _drain_outpost_services() end
    _drain_removals()
end

function on_game_start()
    RegisterScriptCallback(CALLBACK.LOAD_STATE, _on_load_state)
    RegisterScriptCallback(CALLBACK.ON_GAME_LOAD, _on_game_load)

    ap_core_broker.register_owner("warfare", function(squad)
        return squad.registered_with_warfare == true
    end)
    ap_core_debug.info("[COMPAT] Initialized")
end
