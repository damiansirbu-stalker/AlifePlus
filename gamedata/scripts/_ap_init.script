--- _ap_init: dependency gate and platform status. Logic hash-locked identical across mods (deps.logic_hash); identity read from _ap_manifest.

local assert, tostring, type, math_floor = assert, tostring, type, math.floor

local manifest = _ap_manifest.MANIFEST

-- Compatibility floor, YYYYMMDD (stalker-compatibility.md). @src xray/script_ini_file_script.cpp:95-125
local MIN_DEMONIZED_VERSION = 20250908
-- Latest demonized build this release is verified against; drives the MCM verdict only, never the floor (stalker-compatibility.md).
local LATEST_DEMONIZED_VERSION = 20260912
local DEMONIZED_URL = "https://github.com/themrdemonized/xray-monolith"
local AOENGINE_URL  = "https://github.com/Mirrowel/AOEngine-Assets"
local XLIBS_URL     = "https://www.moddb.com/mods/stalker-anomaly/addons/xlibs-1001"

-- xray-monolith build (YYYYMMDD) as the themrdemonized tag style, no zero padding (20260912 -> "2026.9.12").
local function _build_tag(build)
    return math_floor(build / 10000) .. "." .. (math_floor(build / 100) % 100) .. "." .. (build % 100)
end

--- @return string Version string
function get_version()
    return manifest.version
end

-- Platform status line and verdict for the boot log and the MCM footer.
function get_platform_status()
    local xver = (xlibs and xlibs.get_version and xlibs.get_version()) or "?"
    local line = manifest.name .. " " .. manifest.version .. ", xlibs " .. xver
    local has_build = type(get_modded_exes_version) == "function"
    if type(get_aoe_version) == "function" then
        line = line .. ", AOEngine " .. tostring(get_aoe_version())
        if has_build then line = line .. ", xray-monolith " .. _build_tag(get_modded_exes_version()) end
        return line .. " (partially compatible)", "fallback"
    elseif has_build then
        local build = get_modded_exes_version()
        line = line .. ", xray-monolith " .. _build_tag(build)
        if build < LATEST_DEMONIZED_VERSION then
            return line .. " (partially compatible)", "fallback"
        end
        return line .. " (fully compatible)", "full"
    end
    return line .. " (incompatible)", "blocked"
end

-- MCM footer functor: writes get_platform_status into the desc, verdict-colored; colors build lazily (GetARGB absent under the validator).
local _footer_clr = nil
function get_platform_functor()
    return function(_anchor, handlers)
        if not _footer_clr then
            _footer_clr = {
                full     = GetARGB(255, 170, 220, 170),
                fallback = GetARGB(255, 230, 210, 120),
                blocked  = GetARGB(255, 220, 120, 120),
            }
        end
        local line, level = get_platform_status()
        handlers.desc:SetText(line)
        handlers.desc:SetTextColor(_footer_clr[level])
    end
end

function on_game_start()
    assert(xlog,
        "\n\n! [" .. manifest.name .. "] xlibs is not installed.\n"..
        "! " .. manifest.name .. " requires xlibs to function.\n"..
        "! Install xlibs and restart the game.\n"..
        "! " .. XLIBS_URL .. "\n"
    )

    assert(xlibs and xlibs.is_compatible,
        "\n\n! [" .. manifest.name .. "] xlibs is outdated (no compatibility API).\n"..
        "! Update xlibs and restart the game.\n"..
        "! " .. XLIBS_URL .. "\n"
    )

    assert(xlibs.is_compatible(manifest.xlibs),
        "\n\n! [" .. manifest.name .. "] xlibs " .. (xlibs.get_version()) .. " is not compatible.\n"..
        "! " .. manifest.name .. " requires xlibs >= " .. manifest.xlibs .. ".\n"..
        "! Update both xlibs and " .. manifest.name .. ", then restart the game.\n"..
        "! " .. XLIBS_URL .. "\n"
    )

    local has_aoe       = type(get_aoe_version)         == "function"
    local has_demonized = type(get_modded_exes_version) == "function"

    assert(has_aoe or has_demonized,
        "\n\n! [" .. manifest.name .. "] modded exes not detected.\n"..
        "! " .. manifest.name .. " requires themrdemonized modded exes or AOEngine.\n"..
        "! demonized: " .. DEMONIZED_URL .. "\n"..
        "! AOEngine:  " .. AOENGINE_URL .. "\n"
    )

    local demonized_build = has_demonized and get_modded_exes_version() or nil
    if has_demonized and not has_aoe then
        assert(demonized_build >= MIN_DEMONIZED_VERSION,
            "\n\n! [" .. manifest.name .. "] demonized build " .. tostring(demonized_build) ..
            " is older than required.\n"..
            "! " .. manifest.name .. " requires demonized build " ..
            tostring(MIN_DEMONIZED_VERSION) .. " or later.\n"..
            "! Update: " .. DEMONIZED_URL .. "\n"
        )
    end

    local platform_line = (get_platform_status())
    printf("~ [%s] %s", manifest.name, platform_line)
    xlog.get_logger(manifest.name, { outfile = manifest.name:lower() .. ".log" })
        .info("%s", platform_line)
end
