--- ap_ext_trade: NPC supply-trader orchestration, sell surplus then buy up to per-rank policy bands, net-profit capped. See architecture.md Supply Trader.

local floor, pairs, ipairs, tonumber = math.floor, pairs, ipairs, tonumber
local string_match, string_sub = string.match, string.sub
local table_sort, table_concat = table.sort, table.concat
local xinventory, xcreature, xactor, ap_core_debug = xinventory, xcreature, xactor, ap_core_debug
local RegisterScriptCallback = RegisterScriptCallback

local SELL_MULT = 0.5
local BUY_MULT  = 1.0
local DEFAULT_COST = ap_core_const.DEFAULT_TRADE_COST
local POLICY_PATH = "alifeplus\\ap_trade_policy.ltx"
local LOG = "[EXT.TRADE]"
local cfg = ap_core_mcm.cfg

-- Populated by _load_trade_policy at on_game_start; { rookie = { entries, rules }, veteran = { ... } }.
local TRADE_POLICY = nil

-- Load trade policy via xinventory.load_policy (the shared LTX shape across trade, stash, and inventory).
-- Keeps {entries, rules} per tier; the profit cap is the MCM trade_profit_max override applied in Phase 4, not per-tier LTX.
local function _load_trade_policy()
    local blocks = xinventory.load_policy(POLICY_PATH,
        { "ap_trade_policy_rookie", "ap_trade_policy_veteran" })
    TRADE_POLICY = {
        rookie = {
            entries = blocks.ap_trade_policy_rookie.entries,
            rules   = blocks.ap_trade_policy_rookie.rules,
        },
        veteran = {
            entries = blocks.ap_trade_policy_veteran.entries,
            rules   = blocks.ap_trade_policy_veteran.rules,
        },
    }
end

-- Return a fresh cost-asc-sorted copy of sections.
-- Does not mutate the input list, which may be cached by xinventory and shared with other callers.
local function _sort_by_cost(sections)
    local sorted = {}
    for i = 1, #sections do sorted[i] = sections[i] end
    table_sort(sorted, function(a, b)
        return (xinventory.get_cost(a) or DEFAULT_COST) < (xinventory.get_cost(b) or DEFAULT_COST)
    end)
    return sorted
end

-- True for degraded ammo (_bad / _verybad): vanilla ammo_class lists these jammed rounds (w_pm.ltx, w_ak74.ltx) and they are the cheapest.
-- Cheapest-first would otherwise stock every NPC with jammed trash, so they are dropped from the buy candidates.
local function _is_degraded_ammo(sec)
    return sec:sub(-4) == "_bad" or sec:sub(-8) == "_verybad"
end

-- Buy ammo for the target tier, cheapest-first; on cash < cost or create_item failure the inner loop breaks so the outer can try the next section.
-- A cheaper section usually fails the same way (cost is monotonic), but a create_item failure on the cheapest is recoverable by falling through.
local function _run_ammo_buy(npc, seller, weapon_sec, tier_num, target_rounds, bought)
    if not weapon_sec or target_rounds <= 0 then return 0 end
    local tier_map = xinventory.get_ammo_tiers(weapon_sec, 2)

    local tier_sections = {}
    for sec, tier in pairs(tier_map) do
        if tier == tier_num and not _is_degraded_ammo(sec) then tier_sections[#tier_sections + 1] = sec end
    end
    if #tier_sections == 0 then return 0 end
    tier_sections = _sort_by_cost(tier_sections)

    local rounds_added = 0
    for _, sec in ipairs(tier_sections) do
        local box = xinventory.get_box_size(sec) or 30
        local cost = floor((xinventory.get_cost(sec) or DEFAULT_COST) * BUY_MULT)
        while rounds_added < target_rounds do
            if xcreature.get_money(npc) < cost then break end
            if not xinventory.create_item(sec, npc:id(), { ammo = box }) then break end
            xcreature.transfer_money(npc, cost, seller)
            rounds_added = rounds_added + box
            bought[#bought + 1] = sec
        end
        if rounds_added >= target_rounds then break end
    end
    return rounds_added
end

-- Buy copies of one section until count reaches target, cash runs out, or create_item fails (breaks, not errors, so the caller tries the next section).
-- Ammo sections buy whole boxes counted in rounds, everything else one item counted in items, matching xinventory.collect_policy_counts (_unit).
local function _run_section_buy(npc, seller, sec, current, target, bought)
    local box = xinventory.get_box_size(sec)
    local step = box or 1
    local cost = floor((xinventory.get_cost(sec) or DEFAULT_COST) * BUY_MULT)
    while current < target do
        if xcreature.get_money(npc) < cost then break end
        if not xinventory.create_item(sec, npc:id(), box and { ammo = box } or nil) then break end
        xcreature.transfer_money(npc, cost, seller)
        current = current + step
        bought[#bought + 1] = sec
    end
    return current
end

-- Buy from a consumable category cheapest-first until count >= target or no affordable section remains.
-- A section with its own policy row (e.g. grenade_f1) is skipped here; its own entry buys it, matching collect_policy_counts keying.
local function _run_consumable_buy(ctx, category, current, target)
    local sections = xinventory.get_category_sections(category)
    if #sections == 0 then return current end
    local sorted = _sort_by_cost(sections)
    local rules = ctx.rules
    for i = 1, #sorted do
        local sec = sorted[i]
        if not (rules and rules[sec]) then
            current = _run_section_buy(ctx.npc, ctx.seller, sec, current, target, ctx.bought)
        end
        if current >= target then return current end
    end
    return current
end

local function _is_ammo_slot_category(cat)
    return string_sub(cat, 1, 11) == "ammo_slot_2" or string_sub(cat, 1, 11) == "ammo_slot_3"
end

-- For the ammo buy path: resolve the equipped weapon section and tier number from the category.
-- Parses the trailing _t<N> via string_match, so ammo_slot_2_t10 resolves correctly (a last-char slice broke for n_tiers > 9).
local function _resolve_ammo_buy_context(category, cat_opts)
    local prefix = string_sub(category, 1, 11)
    local tier_num = tonumber(string_match(category, "_t(%d+)$"))
    if prefix == "ammo_slot_2" then return cat_opts.equipped_pistol_sec, tier_num end
    if prefix == "ammo_slot_3" then return cat_opts.equipped_rifle_sec,  tier_num end
    return nil, nil
end

-- Execute one BUY policy entry against the NPC's current counts; ctx = { npc, seller, cat_opts, counts, bought, rules }.
-- The key is an ammo-slot (via _run_ammo_buy), a category with members (_run_consumable_buy), or an item section (_run_section_buy).
local function _run_buy_entry(entry, ctx)
    local rule_min = entry.rule.min
    if not (rule_min and rule_min > 0) then return end
    local key = entry.category
    local counts = ctx.counts
    local current = counts[key] or 0
    if current >= rule_min then return end
    if _is_ammo_slot_category(key) then
        local weapon_sec, tier_num = _resolve_ammo_buy_context(key, ctx.cat_opts)
        if not (weapon_sec and tier_num) then return end
        counts[key] = current + _run_ammo_buy(ctx.npc, ctx.seller, weapon_sec, tier_num, rule_min - current, ctx.bought)
    elseif #xinventory.get_category_sections(key) > 0 then
        counts[key] = _run_consumable_buy(ctx, key, current, rule_min)
    else
        counts[key] = _run_section_buy(ctx.npc, ctx.seller, key, current, rule_min, ctx.bought)
    end
end

--- Run a sell + buy trade between an NPC and a trader, per the NPC's rank-tier policy.
--- SELL releases anything over category max and credits the NPC, BUY fills anything under min from post-sell counts + cash, capped by MCM trade_profit_max.
--- @safety SAFE - nil-guarded npc/seller; iterate_inventory tolerant of nil items
--- @cost O(n inventory) | 2 iterate walks + buy loop per policy entry with cash check
--- @param npc game_object Trading NPC (gains money from sales, spends money on buys)
--- @param seller game_object Trader paying for the NPC's ammo/consumable buys
--- @return table { sold = { sec, ... }, bought = { sec, ... } }
function execute_trade(npc, seller)
    local sold, bought = {}, {}
    if not npc or not seller then return { sold = sold, bought = bought } end

    local tier_name = (npc:character_rank() >= ap_core_const.RANK_VETERAN) and "veteran" or "rookie"
    local policy = TRADE_POLICY and TRADE_POLICY[tier_name]
    if not policy then return { sold = sold, bought = bought } end

    local cat_opts = xinventory.get_category_opts(npc)
    local cash_before = xcreature.get_money(npc)

    local counts = xinventory.collect_policy_counts(npc, cat_opts, policy.rules)

    xinventory.iterate_surplus(npc, cat_opts, {
        rules = policy.rules,
        counts = counts,
        on_surplus = function(item, _cat, sec, _unit)
            xinventory.release_item(item)
            xcreature.give_money(npc, floor((xinventory.get_cost(sec) or DEFAULT_COST) * SELL_MULT))
            sold[#sold + 1] = sec
        end,
    })

    local buy_ctx = {
        npc = npc, seller = seller, cat_opts = cat_opts,
        counts = counts, bought = bought, rules = policy.rules,
    }
    for _, entry in ipairs(policy.entries) do
        _run_buy_entry(entry, buy_ctx)
    end

    local cap = cfg.trade_profit_max
    local delta = xcreature.get_money(npc) - cash_before
    if delta > cap then
        xcreature.transfer_money(npc, delta - cap, seller)
    end

    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s npc=%d tier=%s sold=%d[%s] bought=%d[%s] cash=%d->%d",
            LOG, npc:id(), tier_name, #sold, table_concat(sold, ","),
            #bought, table_concat(bought, ","), cash_before, xcreature.get_money(npc))
    end

    return { sold = sold, bought = bought }
end

-- Dump the trade partner's stock to the world log when trade opens (aggregated, one line).
-- The trade feature's own hook, so any trader you open reports its shelf; no-op when world trace is off.
local function _on_trade_started()
    if not ap_core_world_trace.is_enabled() then return end
    local npc = xactor.get_talking_npc()
    if npc then xinventory.log_inventory(npc, "trade", ap_core_world_trace.debug) end
end

function on_game_start()
    _load_trade_policy()
    RegisterScriptCallback(ap_core_const.CALLBACK.ACTOR_MENU_ON_TRADE_STARTED, _on_trade_started)
end
