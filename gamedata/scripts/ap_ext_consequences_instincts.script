--- ap_ext_consequences_instincts: Action-only mutant instinct consequences (7 entries, all 1:1 with cause).

local xobject, xtime, xprofiler, xtrace = xobject, xtime, xprofiler, xtrace
local ap_core_debug, ap_core_broker, ap_core_record, ap_core_consumer, ap_ext_tracker = ap_core_debug, ap_core_broker, ap_core_record, ap_core_consumer, ap_ext_tracker

local CAUSE = ap_core_const.CAUSE
local RESULT = ap_core_const.RESULT
local REASON = ap_core_const.REASON
local CONSEQUENCE = ap_core_const.CONSEQUENCE
local ACTION = ap_core_const.ACTION
local CAUSE_CATEGORY = ap_core_const.CAUSE_CATEGORY
local PRE_RELEASE_GULAG = ap_core_const.PRE_RELEASE_GULAG

local LOG = ap_core_debug.bracket(CAUSE_CATEGORY.INSTINCTS)

local cfg = ap_core_mcm.cfg

local CONFIGS = {
    { consequence = CONSEQUENCE.SCATTER, action = ACTION.SCATTER,             event = CAUSE.SCATTER,        name = "scatter",
      pre_release_gulag = PRE_RELEASE_GULAG.SCATTER },
    { consequence = CONSEQUENCE.FEED, action = ACTION.FEED,                   event = CAUSE.FEED,           name = "feed",
      pre_release_gulag = PRE_RELEASE_GULAG.FEED },
    { consequence = CONSEQUENCE.SLUMBER_FIELD, action = ACTION.SLUMBER_FIELD, event = CAUSE.SLUMBER_FIELD,  name = "slumber_field",
      pre_release_gulag = PRE_RELEASE_GULAG.SLUMBER_FIELD },
    { consequence = CONSEQUENCE.SLUMBER_LAIR, action = ACTION.SLUMBER_LAIR,   event = CAUSE.SLUMBER_LAIR,   name = "slumber_lair",
      pre_release_gulag = PRE_RELEASE_GULAG.SLUMBER_LAIR },
    { consequence = CONSEQUENCE.SLUMBER_SURGE, action = ACTION.SLUMBER_SURGE, event = CAUSE.SLUMBER_SURGE,  name = "slumber_surge",
      pre_release_gulag = PRE_RELEASE_GULAG.SLUMBER_SURGE },
    { consequence = CONSEQUENCE.ROAM, action = ACTION.ROAM,                   event = CAUSE.ROAM,           name = "roam",
      pre_release_gulag = PRE_RELEASE_GULAG.ROAM },
    { consequence = CONSEQUENCE.PACK, action = ACTION.PACK,                   event = CAUSE.PACK,           name = "pack",
      pre_release_gulag = PRE_RELEASE_GULAG.PACK },
}

local function _on_arrive(squad, args)
    if not args then return end
    local dbg = ap_core_debug.enabled()
    local tid = dbg and xtrace.new().id or 0
    local tmr = xprofiler.new_if(dbg):start()
    if args.dto_field then
        ap_ext_tracker.reset_mutant_instinct(squad.id, args.dto_field, xtime.game_sec())
    end
    tmr:stop()
    if dbg then
        ap_core_debug.debug("%s [tid=%d] complete instinct=%s dst=%s [%.2fms]", LOG, tid,
            args.name or "?", args.dst_name or "?", tmr:get_ms())
    end
end

local function _make_condition(enabled_key)
    return function() return cfg[enabled_key] end
end

local function _make_handler(entry)
    return function(event_data)
        local squad = xobject.se(event_data.squad_id)
        if not squad then return { code = RESULT.FAILED_SCAN, reason = REASON.NO_SQUAD } end
        local smart = xobject.se(event_data.dst_smart_id)
        if not smart then return { code = RESULT.FAILED_SCAN, reason = REASON.NO_SMART } end

        local res = ap_core_broker.script_squad(squad, smart, {
            rush = cfg["consequence_" .. entry.name .. "_rush"],
            on_arrive = entry.consequence,
            on_arrive_args = { dto_field = event_data.dto_field, name = entry.name, dst_name = smart:name() },
            pre_release_gulag = entry.pre_release_gulag,
            interruptable = true,
        })
        if res.code ~= RESULT.SUCCESS then
            return { code = RESULT.FAILED_ACTION, reason = res.reason or REASON.MOVE_FAILED }
        end
        ap_core_record.add_record(squad, event_data.cause, entry.consequence, {
            action_key = entry.action,
            smart = smart, level_id = event_data.level_id,
        })
        return { code = RESULT.SUCCESS }
    end
end

function on_game_start()
    for i = 1, #CONFIGS do
        local entry = CONFIGS[i]
        local enabled_key = "consequence_" .. entry.name .. "_enabled"
        ap_core_consumer.register(entry.consequence, {
            event = entry.event,
            condition = _make_condition(enabled_key),
            on_arrive = _on_arrive,
        }, _make_handler(entry))
    end
    ap_core_debug.info(LOG .. " Initialized: %d consequences", #CONFIGS)
end
