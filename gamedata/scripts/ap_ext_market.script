--- ap_ext_market: faction market, the player-facing echo of NPC trading at a faction's hub traders (injection + sell-out). See architecture.md Faction market.

local RegisterScriptCallback = RegisterScriptCallback
local math_random, math_floor = math.random, math.floor
local pairs, tonumber, type, tostring, next = pairs, tonumber, type, tostring, next
local table_remove, table_concat, table_sort = table.remove, table.concat, table.sort
local xinventory, xsquad, xtime, xevent, xttltable, xobject, xprofiler =
    xinventory, xsquad, xtime, xevent, xttltable, xobject, xprofiler
local CALLBACK = ap_core_const.CALLBACK
local cfg = ap_core_mcm.cfg

local LOG = "[EXT.MARKET]"
local POLICY_PATH = "alifeplus\\ap_market_policy.ltx"
local TRADER_BUY_SECTION = "ap_market_trader_buy"
local TRADER_SELL_SECTION = "ap_market_trader_sell"
local FLOOR_SECTION = "ap_market_rank_floor"
local CHANCE_SECTION = "ap_market_rank_chance"
local SPECIALS = { fifo_max = true }
local RELEASE_EV = "ap_market_release"
local RELEASE_PERIOD_MS = 60000
local VIEW_LOG_INTERVAL_SEC = 3
local SAVE_KEY = "ap_ext_market"
local DEFAULT_FIFO_MAX = 20
-- Chatter fires only when the most valuable injected item clears this base cost (pre-premium rubles), so stalkers mention rifles, not bread.
local CHATTER_MIN_COST = 5000

-- Factions that never seed the market (no real allegiance / cannot trade goods)
local _SKIP_FACTION = { trader = true, monster = true, zombied = true, [""] = true }
-- Role -> categories that role may stock: general trader all whitelisted, medic consumables, mechanic gear/parts.
local _MEDICAL = { medkit = true, bandage = true, antirad = true, stim = true, pill = true, food = true, drink = true }
local _GEAR = { weapon = true, helmet = true, device = true, crafting = true, grenade = true }

-- { trader_buy, trader_sell, specials } from POLICY_PATH; trader_buy = injection whitelist, trader_sell = sell-out (ammo+medical), key = {min,max}.
local MARKET_POLICY = nil
-- { floor = { [section|category] = tier }, bands = { [tier] = { {cost,chance} asc }, default } }
local RANK_RULESET = nil

-- Trader-bought FIFO: faction -> dedup FIFO of sections traders took from stalkers (NPC sold), fifo_max bound; plain table, load-safe. Feeds injection.
local _trader_bought = {}
-- Trader-sold mirror: faction -> dedup FIFO of sections traders handed to stalkers (NPC bought), same shape; a sold-out section is claimed. Feeds sell-out.
local _trader_sold = {}
-- Distribution claim (ttl_table, ephemeral): a section injected or sold out is claimed so siblings act on different items. Reset on load, harmless.
local _claimed = nil
-- item_id -> { trader_id, inject_time, section } for tagged goods, persisted across save/load; parent==trader guard at pricing/release. See architecture.md.
local _market_goods = {}
-- Reused collector for expired ids, so _release_expired never mutates _market_goods mid-iteration.
local _release_buf = {}
-- Debug throttle: trader_id -> next os.clock at which a trade-view line may log again.
local _view_log_next = {}

local _subscribed = false

-- POLICY LOADING

--- Load the trader-buy whitelist (+ specials) and the trader-sell whitelist via the shared xinventory kernel.
--- Same row shape; injection reads .trader_buy, the sell-out reads .trader_sell.
--- @cost O(lines) | 1 ini parse at on_game_start
local function _load_policy()
    local blocks = xinventory.load_policy(POLICY_PATH, { TRADER_BUY_SECTION, TRADER_SELL_SECTION }, SPECIALS)
    MARKET_POLICY = {
        trader_buy = blocks[TRADER_BUY_SECTION].rules,
        trader_sell = blocks[TRADER_SELL_SECTION].rules,
        specials = blocks[TRADER_BUY_SECTION].specials,
    }
end

--- Strip whitespace and split "a:b" into two numbers; nil on malformed.
local function _parse_band(pair)
    local cs = str_explode(pair:gsub("%s+", ""), ":")
    local cost, chance = tonumber(cs[1]), tonumber(cs[2])
    if cost and chance then return { cost = cost, chance = chance } end
    return nil
end

local function _is_cheaper(a, b) return a.cost < b.cost end

--- Parse a "cost:chance, cost:chance, ..." cell into an ascending band row.
local function _parse_chance_row(value)
    local row = {}
    local list = str_explode(value, ",")
    for j = 1, #list do
        local band = _parse_band(list[j])
        if band then row[#row + 1] = band end
    end
    table_sort(row, _is_cheaper)
    return row
end

--- Invoke fn(key, value) for every non-empty key/value line of an ini section.
local function _iterate_kv(ini, section, fn)
    if not ini:section_exist(section) then return end
    for i = 0, ini:line_count(section) - 1 do
        local _, key, value = ini:r_line_ex(section, i, "", "")
        if key and key ~= "" and value and value ~= "" then fn(key, value) end
    end
end

--- Parse the two rank blocks into the get_rank_chance ruleset. Both optional.
--- @cost O(lines) | 1 ini parse at on_game_start
local function _load_rank_ruleset()
    local ini = ini_file(POLICY_PATH)
    local floor, bands = {}, {}
    _iterate_kv(ini, FLOOR_SECTION, function(key, value) floor[key] = value end)
    _iterate_kv(ini, CHANCE_SECTION, function(key, value) bands[key] = _parse_chance_row(value) end)
    RANK_RULESET = { floor = floor, bands = bands }
end

-- CONFIG ACCESSORS

local function _get_premium()        return cfg.market_premium end
local function _get_item_condition()  return cfg.market_item_condition end
local function _get_trader_sell_percent()  return cfg.market_trader_sell_percent end
local function _get_fifo_max()      return (MARKET_POLICY and MARKET_POLICY.specials.fifo_max) or DEFAULT_FIFO_MAX end
local function _get_goods_window_sec() return cfg.market_window_hours * 3600 end
local function _get_per_trader_cap()
    return cfg.market_items_per_trader
end

-- FIFOS (observe ap_ext_trade output)

local function _is_market_faction(faction)
    return faction ~= nil and not _SKIP_FACTION[faction]
end

--- Push a section into a faction FIFO (an NPC sale -> _trader_bought, an NPC purchase -> _trader_sold).
--- Dedup (drop any existing position), append as newest, evict the oldest once over the cap.
--- @param store table _trader_bought or _trader_sold
--- @param label string Trace tag: "bought" or "sold"
local function _push_fifo(store, faction, section, label)
    local list = store[faction]
    if not list then
        list = {}
        store[faction] = list
    end
    for i = 1, #list do
        if list[i] == section then table_remove(list, i); break end
    end
    list[#list + 1] = section
    local evicted
    if #list > _get_fifo_max() then evicted = table_remove(list, 1) end
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s %s faction=%s +%s n=%d%s", LOG, label, faction, section, #list,
            evicted and (" evict=" .. evicted) or "")
    end
end

--- xevent wrapper over ap_ext_trade.execute_trade: run the original, then record the result in trader perspective by the NPC's faction.
--- What the NPC sold enters _trader_bought, what it bought enters _trader_sold; pure observation, the return value passes through untouched.
--- @param orig function The original ap_ext_trade.execute_trade
--- @param npc game_object The visiting NPC who traded with the trader
--- @param seller game_object The trader (unused here)
--- @return table The original { sold, bought }
local function _on_market_trade(orig, npc, seller)
    local result = orig(npc, seller)
    if not cfg.market_enabled then return result end
    if not (npc and result) then return result end
    local sold, bought = result.sold or {}, result.bought or {}
    if #sold == 0 and #bought == 0 then return result end
    local squad = xsquad.get_member_squad(npc:id())
    local faction = squad and xsquad.get_community(squad)
    if not _is_market_faction(faction) then return result end
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s observe faction=%s npc=%d sold=%s bought=%s", LOG, faction, npc:id(),
            table_concat(sold, ","), table_concat(bought, ","))
    end
    for i = 1, #sold do _push_fifo(_trader_bought, faction, sold[i], "bought") end
    for i = 1, #bought do _push_fifo(_trader_sold, faction, bought[i], "sold") end
    return result
end

-- INJECTION

--- True if a trader serving role_info may stock items of this category.
local function _can_accept_category(role_info, category)
    if role_info.trader then return true end
    if role_info.medic and _MEDICAL[category] then return true end
    if role_info.mechanic and _GEAR[category] then return true end
    return false
end

--- The policy key for a section (its own row if listed, else its category) and the matching rule.
local function _get_rule(section, category, rules)
    local key = rules[section] and section or category
    return key, rules[key]
end

--- Trace one eligibility rejection when debug is on, tagged with the direction ("inject" or "sellout").
--- Always returns false, so eligibility guards can `return _log_skip(...)` in one line.
local function _log_skip(dir, section, why, ...)
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s %s skip %s " .. why, LOG, dir, section, ...)
    end
    return false
end

--- Decide whether one FIFO section is actionable at a faction trader: not claimed this window, whitelisted with a positive cap, role-accepted, rank-rolled.
--- The one market filter chain; injection and sell-out run it identically against their own whitelist ([ap_market_trader_buy] / [ap_market_trader_sell]).
local function _is_section_eligible(section, faction, role_info, rules, dir)
    if _claimed:has(faction .. "|" .. section) then return _log_skip(dir, section, "claimed") end
    local category = xinventory.get_section_category(section)
    local _, rule = _get_rule(section, category, rules)
    if not (rule and rule.max and rule.max > 0) then return _log_skip(dir, section, "not-whitelisted cat=%s", category) end
    if not _can_accept_category(role_info, category) then return _log_skip(dir, section, "role-reject cat=%s", category) end
    local chance = xinventory.get_rank_chance(section, db.actor, RANK_RULESET)
    if math_random() > chance then return _log_skip(dir, section, "rank-roll chance=%.2f", chance) end
    return true
end

--- Collect the sections eligible for market action at a faction trader, walking one faction FIFO.
--- _trader_bought for injection, _trader_sold for the sell-out; both directions pass the identical filter.
--- @cost O(L) FIFO length + per match: get_section_category + get_rank_chance
--- @param store table _trader_bought or _trader_sold
--- @param dir string Trace tag: "inject" or "sellout"
--- @return table Array of distinct section names
local function _collect_eligible_sections(store, faction, role_info, rules, dir)
    local out = {}
    local list = store[faction]
    if not list then return out end
    for i = 1, #list do
        local section = list[i]
        if _is_section_eligible(section, faction, role_info, rules, dir) then out[#out + 1] = section end
    end
    return out
end

--- Fisher-Yates shuffle in place (per-restock randomisation of the eligible set).
local function _shuffle(t)
    for i = #t, 2, -1 do
        local j = math_random(i)
        t[i], t[j] = t[j], t[i]
    end
end

--- Try to inject one section at the trader, honouring its per-category cap; spawns at the configured condition.
--- Tags the item for the premium hook + timed release and claims it; ctx = { trader_id, faction, rules, cat_count, cond, window, now }.
local function _try_inject_section(ctx, sec)
    local category = xinventory.get_section_category(sec)
    local key, rule = _get_rule(sec, category, ctx.rules)
    local used = ctx.cat_count[key] or 0
    if used >= rule.max then
        if ap_core_debug.is_enabled() then ap_core_debug.debug("%s inject skip %s cat-cap %s full", LOG, sec, key) end
        return false
    end
    local item_se = xinventory.create_item(sec, ctx.trader_id, { cond = ctx.cond })
    if not (item_se and item_se.id) then
        if ap_core_debug.is_enabled() then ap_core_debug.debug("%s inject spawn-fail %s", LOG, sec) end
        return false
    end
    _market_goods[item_se.id] = { trader_id = ctx.trader_id, inject_time = ctx.now, section = sec }
    _claimed:set(ctx.faction .. "|" .. sec, true, ctx.window)
    ctx.cat_count[key] = used + 1
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s inject %s id=%d base=%d premium=%sx cond=%.2f", LOG, sec, item_se.id,
            xinventory.get_cost(sec) or 0, _get_premium(), ctx.cond)
    end
    return true
end

--- Resolve a trader's curated role + faction from xdata.npc_roles; nil (with a debug note) for an uncurated trader.
--- Split out to keep _run_injection under the complexity ceiling.
local function _resolve_trader_role(trader)
    local se = xobject.get_se(trader:id())
    if not se then return nil end
    local section = se:section_name()
    local role_info = section and xdata.npc_roles[section]
    if role_info and role_info.faction then return role_info end
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s restock trader=%d no-role sec=%s", LOG, trader:id(), tostring(section))
    end
    return nil
end

-- TRADER SELL-OUT (removal at restock)

--- Strip an ammo section's condition suffix so every degraded variant collapses to one bullet type (ammo_9x18_fmj_verybad -> ammo_9x18_fmj).
--- NPCs buy the cheapest degraded variant, traders restock the clean one; matching on bullet type lets the two meet.
local function _get_bullet_type(sec)
    return (sec:gsub("_verybad$", ""):gsub("_bad$", ""))
end

--- The grouping key the sell-out matches demand to stock on; ammo groups by bullet type, everything else by its whitelist rule key.
--- Any condition variant of the same round counts together, but 9x18 fmj and 9x18 ap stay separate.
local function _get_sellout_class(sec, rules)
    local category = xinventory.get_section_category(sec)
    if category == "ammo_not_equipped" then return _get_bullet_type(sec) end
    local key = _get_rule(sec, category, rules)
    return key
end

--- Walk the trader's freshly respawned stock once and bucket removable items by sell-out class, keeping only classes the demand FIFO wants.
--- Skips tagged market goods (the sell-out never eats the injected echo) and the trader's equipped items.
--- @cost O(items) | 1 iterate_inventory walk, O(1) per item
--- @param trader game_object Online trader
--- @param wanted table { [class] = true } sell-out classes to collect
--- @param rules table Trader-sell whitelist (for class resolution)
--- @return table { [class] = { item_go, ... } } wanted classes actually present in stock
local function _collect_trader_sold_stock(trader, wanted, rules)
    local stock = {}
    local equipped = xinventory.get_equipped_ids(trader)
    xinventory.iterate_inventory(trader:id(), function(_, item)
        if not (_market_goods[item:id()] or equipped[item:id()]) then
            local cls = _get_sellout_class(item:section(), rules)
            if wanted[cls] then
                local list = stock[cls]
                if not list then list = {}; stock[cls] = list end
                list[#list + 1] = item
            end
        end
    end)
    return stock
end

--- Sell out one class from the trader's stock: release floor(held x percent / 100) items at random and claim each removed section for the window.
--- The share rounds down, so scarce stock survives at low pct; returns (removed_count, rep_section), ctx = { trader_id, faction, pct, window }.
local function _try_get_sellout_class(ctx, cls, items)
    local held = items and #items or 0
    local remove = math_floor(held * ctx.pct / 100)
    if remove <= 0 then
        if ap_core_debug.is_enabled() then ap_core_debug.debug("%s sellout skip %s held=%d below-share", LOG, cls, held) end
        return 0
    end
    _shuffle(items)
    local removed_secs = {}
    for j = 1, remove do
        local item = items[j]
        removed_secs[item:section()] = true
        xinventory.release_item(item)
    end
    for sec in pairs(removed_secs) do
        _claimed:set(ctx.faction .. "|" .. sec, true, ctx.window)
    end
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s sellout trader=%d class=%s removed=%d/held=%d", LOG, ctx.trader_id, cls, remove, held)
    end
    return remove, next(removed_secs)
end

--- Push one chatter line when a trader has just run short of a staple (the sell-out mirror of _try_chatter).
--- ap_ext_news.publish_chatter owns speaker/throttle/level/faction gates; this only names the trader, item, and place; silent if the level is unresolved.
--- @param trader game_object The trader that ran short
--- @param section string Representative section of the most-depleted class
--- @param faction string The trader's faction
local function _try_sellout_chatter(trader, section, faction)
    local se = xobject.get_se(trader:id())
    local level_id = se and xlevel.get_level_id(se)
    if not level_id then return end
    ap_ext_news.publish_chatter("st_ap_chatter_market_short", {
        trader   = trader:character_name() or "",
        item     = xinventory.get_item_name(section),
        location = xlevel.get_level_name(level_id) or "",
    }, { level_id = level_id, faction = faction })
end

--- Sell out at one online trader what he recently sold to his faction's stalkers: the mirror of _run_injection over _trader_sold, matched by sell-out class.
--- Runs before _run_injection and claims what it removes so injection skips it; the engine respawns config next cycle, so removal never damages a trader.
--- @safety SAFE - bails on disabled, zero percent, dead trader, unresolved role/faction, nil policy
--- @param trader game_object Online trader at its restock
local function _run_sellout(trader)
    if not cfg.market_enabled or not MARKET_POLICY then return end
    if not trader or not trader:alive() then return end
    local pct = _get_trader_sell_percent()
    if pct <= 0 then return end
    local cap = _get_per_trader_cap()
    if cap <= 0 then return end

    local role_info = _resolve_trader_role(trader)
    if not role_info then return end
    local faction = role_info.faction
    local trader_id = trader:id()
    local tname = ap_core_debug.is_enabled() and (trader:character_name() or "?") or "?"

    local rules = MARKET_POLICY.trader_sell
    local eligible = _collect_eligible_sections(_trader_sold, faction, role_info, rules, "sellout")
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s sellout trader=%d(%s) faction=%s pct=%d cap=%d eligible=%d", LOG,
            trader_id, tname, faction, pct, cap, #eligible)
    end
    if #eligible == 0 then return end

    local wanted = {}
    for i = 1, #eligible do wanted[_get_sellout_class(eligible[i], rules)] = true end
    local stock = _collect_trader_sold_stock(trader, wanted, rules)
    local classes = {}
    for cls in pairs(stock) do classes[#classes + 1] = cls end
    _shuffle(classes)

    local ctx = { trader_id = trader_id, faction = faction, pct = pct, window = _get_goods_window_sec() }
    local sold_out, best_removed, best_sec = 0, 0, nil
    for i = 1, #classes do
        if sold_out >= cap then break end
        local removed, sec = _try_get_sellout_class(ctx, classes[i], stock[classes[i]])
        if removed > 0 then
            sold_out = sold_out + 1
            if removed > best_removed then best_removed, best_sec = removed, sec end
        end
    end
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s sellout trader=%d(%s) faction=%s sold_out=%d/%d", LOG,
            trader_id, tname, faction, sold_out, cap)
    end
    if best_sec then _try_sellout_chatter(trader, best_sec, faction) end
end

--- Push one chatter line about a notable item this trader just took in, only when the trader is on the player's level (chatter is local).
--- ap_ext_news.publish_chatter owns the selection policy (map, faction, voice, throttle); silent if the trader's level cannot be resolved.
--- @param trader game_object The trader that restocked
--- @param section string The most valuable section injected this restock
--- @param faction string The trader's faction (role_info.faction)
local function _try_chatter(trader, section, faction)
    local se = xobject.get_se(trader:id())
    local level_id = se and xlevel.get_level_id(se)
    if not level_id then return end
    ap_ext_news.publish_chatter("st_ap_chatter_market", {
        trader   = trader:character_name() or "",
        item     = xinventory.get_item_name(section),
        location = xlevel.get_level_name(level_id) or "",
    }, { level_id = level_id, faction = faction })
end

--- Inject a bounded echo of the faction's recently-sold goods into one online trader (skips traders with no resolved role/faction).
--- Picks up to the per-trader cap honouring per-category caps, spawns at the configured condition, tags for the premium hook + release, and claims each.
--- @safety SAFE - bails on disabled, dead trader, unresolved role/faction, nil policy
--- @param trader game_object Online trader at its restock
local function _run_injection(trader)
    if not cfg.market_enabled or not MARKET_POLICY then return end
    if not trader or not trader:alive() then return end
    local cap = _get_per_trader_cap()
    if cap <= 0 then return end

    local role_info = _resolve_trader_role(trader)
    if not role_info then return end
    local faction = role_info.faction
    local tname = ap_core_debug.is_enabled() and (trader:character_name() or "?") or "?"

    local rules = MARKET_POLICY.trader_buy
    local eligible = _collect_eligible_sections(_trader_bought, faction, role_info, rules, "inject")
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s restock trader=%d(%s) faction=%s cap=%d eligible=%d", LOG, trader:id(), tname, faction, cap, #eligible)
    end
    if #eligible == 0 then return end
    _shuffle(eligible)

    local ctx = {
        trader_id = trader:id(), faction = faction, rules = rules,
        cat_count = {}, cond = _get_item_condition(),
        window = _get_goods_window_sec(), now = xtime.get_game_sec(),
    }
    local injected = 0
    local best_sec, best_cost = nil, 0
    for i = 1, #eligible do
        if injected >= cap then break end
        local sec = eligible[i]
        if _try_inject_section(ctx, sec) then
            injected = injected + 1
            local cost = xinventory.get_cost(sec) or 0
            if cost > best_cost then best_cost, best_sec = cost, sec end
        end
    end
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s restock trader=%d(%s) faction=%s injected=%d/%d", LOG, trader:id(), tname, faction, injected, cap)
    end
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s chatter gate trader=%d best=%s cost=%d min=%d", LOG, trader:id(),
            tostring(best_sec), best_cost, CHATTER_MIN_COST)
    end
    if best_sec and best_cost >= CHATTER_MIN_COST then _try_chatter(trader, best_sec, faction) end
end

--- Deferred sell-out + inject for the restock path: by the time this fires (0.1s after the engine restock) the fresh config stock is registered.
--- The sell-out runs first; its claims keep injection off the sold-out sections; returns true (one-shot).
local function _run_restock(trader_id)
    local trader = xobject.get_go(trader_id)
    if trader then
        local dbg = ap_core_debug.is_enabled()
        if ap_core_world_trace.is_enabled() then xinventory.log_inventory(trader, "market", ap_core_world_trace.debug) end
        local tmr = xprofiler.new_if(dbg):start()
        _run_sellout(trader)
        _run_injection(trader)
        tmr:stop()
        if dbg then ap_core_debug.debug("%s reshape trader=%d [%.2fms]", LOG, trader_id, tmr:get_ms()) end
    end
    return true
end

-- RESTOCK DETECTION (exactly one path)

--- Detect a real restock by trade_manager.update advancing resupply_time (an unchanged reference means no restock).
--- Defer the inject 0.1s so the freshly spawned stock registers.
local function _update_wrapper(orig, npc, force_refresh)
    if not (npc and npc.alive and npc:alive()) then return orig(npc, force_refresh) end
    local id = npc:id()
    local before = trade_manager.get_trade_profile(id, "resupply_time")
    orig(npc, force_refresh)
    if not cfg.market_enabled then return end
    local after = trade_manager.get_trade_profile(id, "resupply_time")
    if after and after ~= before then
        CreateTimeEvent("ap_market_restock", id, 0.1, _run_restock, id)
    end
end

--- Wire the restock path via a hook over trade_manager.update; every install advances resupply_time there (vanilla directly, autoinject via monkeypatch).
--- No capability probe (RegisterScriptCallback on an undeclared name silently drops); touch trade_manager first so xevent.register_hook can rawget it.
local function _init_restock()
    local _ = trade_manager
    xevent.register_hook("trade_manager", "update", _update_wrapper)
    ap_core_debug.info("%s restock via trade_manager.update hook", LOG)
end

-- PREMIUM PRICING

-- Debug: log one tagged good's live state at the viewed trader (online, current owner, condition).
-- Names why a good the player expected can be missing; split out so _log_trade_view stays a flat walk.
local function _log_trade_good(trader_id, id)
    local go = xobject.get_go(id)
    if not go then
        ap_core_debug.debug("%s view-good trader=%d id=%d offline (no game object)", LOG, trader_id, id)
        return
    end
    local parent = go:parent()
    ap_core_debug.debug("%s view-good trader=%d id=%d sec=%s parent=%s cond=%.2f", LOG,
        trader_id, id, go:section(), tostring(parent and parent:id()), go:condition())
end

-- Debug: while a trader's buy panel is open, on_get_item_cost fires per item; log which trader and how many market goods it holds, throttled per trader.
-- Skips the actor's own (sell-side) items.
local function _log_trade_view(obj)
    if not ap_core_debug.is_enabled() then return end
    local parent = obj:parent()
    local actor = db.actor
    if not parent or (actor and parent:id() == actor:id()) then return end
    local trader_id = parent:id()
    local now = os.clock()
    if (_view_log_next[trader_id] or 0) > now then return end
    _view_log_next[trader_id] = now + VIEW_LOG_INTERVAL_SEC
    local count = 0
    for id, tag in pairs(_market_goods) do
        if tag.trader_id == trader_id then
            count = count + 1
            _log_trade_good(trader_id, id)
        end
    end
    ap_core_debug.debug("%s view trader=%d(%s) market_goods=%d", LOG, trader_id, parent:character_name() or "?", count)
end

--- on_get_item_cost handler: for a tagged market good in its injecting trader, override the price to base cost x premium (condition discount dropped).
--- Writes ret.new_cost (utils_item.script returns tonumber(ret.new_cost) or cost); non-market items are untouched.
--- @param obj game_object The item being priced
--- @param profile table Trade profile (carries .discount)
--- @param ret table Output: set ret.new_cost to override
local function _on_get_item_cost(_kind, obj, profile, _cost, ret)
    if not (cfg.market_enabled and obj and ret) then return end
    _log_trade_view(obj)
    local tag = _market_goods[obj:id()]
    if not tag then return end
    local parent = obj:parent()
    if not (parent and parent:id() == tag.trader_id) then return end
    local base = obj:cost() or 0
    local price = math_floor(base * _get_premium() * (profile and profile.discount or 1))
    ret.new_cost = price
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s price id=%d base=%d cond=%.2f -> %d", LOG, obj:id(), base, obj:condition(), price)
    end
end

-- WINDOW RELEASE

--- Release one market good only if it is still the injected item in its injecting trader (online, parent == trader_id, section matches the tag).
--- A bought / sold-on / purged / recycled good fails identity and is left untouched; the caller drops the tag either way.
local function _release_good(id, tag)
    local obj = xobject.get_go(id)
    if not obj then return end
    local parent = obj:parent()
    if not (parent and parent:id() == tag.trader_id) then return end
    if tag.section and obj:section() ~= tag.section then return end
    xinventory.release_item(obj)
end

-- Debug-only vanish trace: name a tagged good that left its trader before its window expired (released, or moved to another owner).
-- Observation only, once per good (tag.gone_logged), never untags; the expiry path still owns the tag lifecycle.
-- @cost O(1) | 1 luabind (xobject.get_se) per live tag per period, debug on only
local function _log_vanished(id, tag)
    if tag.gone_logged then return end
    local se_item = xobject.get_se(id)
    if se_item and se_item.parent_id == tag.trader_id then return end
    tag.gone_logged = true
    ap_core_debug.debug("%s good_gone: trader=%d id=%d sec=%s %s", LOG, tag.trader_id, id,
        tostring(tag.section), se_item and ("owner=" .. tostring(se_item.parent_id)) or "released")
end

--- Release market goods past their window (repeating timer); the engine restock also wipes goods, so this is primary cleanup only for a sub-restock window.
--- Expired ids are collected first (module buffer), then released + untagged after the walk, so _market_goods is never mutated mid-iteration.
local function _release_expired()
    local now = xtime.get_game_sec()
    local window = _get_goods_window_sec()
    local debug_on = ap_core_debug.is_enabled()
    local count = 0
    for id, tag in pairs(_market_goods) do
        if now - tag.inject_time >= window then
            count = count + 1
            _release_buf[count] = id
        elseif debug_on then
            _log_vanished(id, tag)
        end
    end
    for i = 1, count do
        local id = _release_buf[i]
        _release_good(id, _market_goods[id])
        _market_goods[id] = nil
        _release_buf[i] = nil
    end
    if count > 0 and ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s released %d expired", LOG, count)
    end
    ResetTimeEvent(RELEASE_EV, RELEASE_EV, RELEASE_PERIOD_MS / 1000)
    return false
end

-- SAVE / LOAD

local function _on_save(m_data)
    m_data[SAVE_KEY] = { trader_bought = _trader_bought, trader_sold = _trader_sold, market_goods = _market_goods }
end

local function _on_load(m_data)
    local data = m_data and m_data[SAVE_KEY]
    if not data then return end
    if type(data.trader_bought) == "table" then _trader_bought = data.trader_bought end
    if type(data.trader_sold) == "table" then _trader_sold = data.trader_sold end
    if type(data.market_goods) == "table" then _market_goods = data.market_goods end
end

--- Drop restored goods whose item no longer exists (a trader purged its ruck on an offline restock between save and load); runs once at first update.
--- A recycled id that survives is still rejected at pricing time by the parent==trader guard in _on_get_item_cost, so premium never mis-applies.
local function _check_market_goods()
    local dropped = 0
    for id in pairs(_market_goods) do
        if not xobject.get_se(id) then
            _market_goods[id] = nil
            dropped = dropped + 1
        end
    end
    if dropped > 0 and ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s load dropped %d stale goods", LOG, dropped)
    end
end

-- LIFECYCLE

local function _on_first_update()
    if _subscribed then return end
    _subscribed = true
    _check_market_goods()
    local _ = ap_ext_trade
    xevent.register_hook("ap_ext_trade", "execute_trade", _on_market_trade)
    RegisterScriptCallback(CALLBACK.ON_GET_ITEM_COST, _on_get_item_cost)
    _init_restock()
    CreateTimeEvent(RELEASE_EV, RELEASE_EV, RELEASE_PERIOD_MS / 1000, _release_expired)
    ap_core_debug.info("%s subscribed", LOG)
end

function on_game_start()
    _subscribed = false
    _market_goods = {}
    _trader_bought = {}
    _trader_sold = {}
    _load_policy()
    _load_rank_ruleset()
    _claimed = xttltable.create_ttl_table({ clock = xtime.get_game_sec })
    RegisterScriptCallback(CALLBACK.SAVE_STATE, _on_save)
    RegisterScriptCallback(CALLBACK.LOAD_STATE, _on_load)
    RegisterScriptCallback(CALLBACK.ACTOR_ON_FIRST_UPDATE, _on_first_update)
    ap_core_debug.info("%s Initialized", LOG)
end
