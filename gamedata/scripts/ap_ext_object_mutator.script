--- ap_ext_object_mutator: combat identity of the earned alpha status (hit power dealt/taken, panic immunity, trophy loot, particle mark), all event-driven.

local pairs, next, tostring, math_random, RegisterScriptCallback = pairs, next, tostring, math.random, RegisterScriptCallback
local xtable, xcreature, xobject = xtable, xcreature, xobject
local ap_core_debug, ap_ext_tracker = ap_core_debug, ap_ext_tracker

local CALLBACK = ap_core_const.CALLBACK
local ALPHA_LOOT = ap_ext_const.ALPHA_LOOT
local ALPHA_MAX_LEVEL = 10
local cfg = ap_core_mcm.cfg
local LOG = "[MUTATOR.OBJECT]"

-- Mark particle set, picked by id (config-referenced names only; an unknown name is an engine fatal).
local MARK_PARTICLES = {
    "generator\\anomaly_gen_dust",
}
local MARK_BONES = { "bip01_head", "bip01_spine", "bip01_pelvis", "link" }
local BI_NONE = 65535

-- Alpha id state: _alpha_ids (early-out + panic key), _hit_power_* (multipliers), _panic_applied (dedupe), _marks (name+bone to stop).
local _alpha_ids = {}
local _hit_power_dealt = {}
local _hit_power_taken = {}
local _panic_applied = {}
local _marks = {}

-- Attach the alpha's mark to its live game object; no-op when disabled, offline, dead, or already emitting.
-- Bone verified via get_bone_id before attach (BI_NONE on a miss).
-- @cost O(1) | up to 6 luabind on attach (object_by_id, alive, <=4 get_bone_id, start_particles); promote/net-spawn-time only
local function _try_apply_mark(npc_id)
    if not cfg.mutator_alpha_mark_enabled or _marks[npc_id] then return end
    local obj = xobject.get_go(npc_id)
    if not obj or not obj:alive() then return end
    local bone
    for i = 1, #MARK_BONES do
        if obj:get_bone_id(MARK_BONES[i]) ~= BI_NONE then bone = MARK_BONES[i] break end
    end
    if not bone then return end
    local name = MARK_PARTICLES[npc_id % #MARK_PARTICLES + 1]
    obj:start_particles(name, bone)
    _marks[npc_id] = { name = name, bone = bone }
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s mark id=%d particle=%s bone=%s", LOG, npc_id, name, bone)
    end
end

-- Stop the mark and forget it; safe when the game object is already gone (its particles died with it).
-- Required on a corpse: particles have no lifecycle and would emit forever.
-- @cost O(1) | <=2 luabind
local function _stop_mark(npc_id)
    local mark = _marks[npc_id]
    if not mark then return end
    local obj = xobject.get_go(npc_id)
    if obj then obj:stop_particles(mark.name, mark.bone) end
    _marks[npc_id] = nil
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s mark_stop id=%d particle=%s", LOG, npc_id, mark.name)
    end
end

--- Register the combat effects for a promoted alpha (from the alpha_promote consequence and the rebuild).
--- Multiplier = 1 +/- max_pct/100 * level/ALPHA_MAX_LEVEL; the mark attaches when the alpha is online (net spawn covers the rest).
--- @safety SAFE - pure table writes; nil-guarded args; mark attach is bone-verified
--- @cost O(1) | 0 luabind (plus the one-time mark attach when online)
--- @param npc_id number Alpha entity id
--- @param level number Alpha level (1..ALPHA_MAX_LEVEL)
function set_alpha_effects(npc_id, level)
    if not npc_id or not level or level < 1 then return end
    _alpha_ids[npc_id] = true
    if cfg.mutator_alpha_hit_power_dealt_enabled then
        _hit_power_dealt[npc_id] = 1.0 + (cfg.mutator_alpha_hit_power_dealt_max_pct / 100) * (level / ALPHA_MAX_LEVEL)
    end
    if cfg.mutator_alpha_hit_power_taken_enabled then
        _hit_power_taken[npc_id] = 1.0 - (cfg.mutator_alpha_hit_power_taken_max_pct / 100) * (level / ALPHA_MAX_LEVEL)
    end
    _try_apply_mark(npc_id)
end

-- Dealt-scaling shared by all three victim seams: an alpha attacker multiplies the hit.
-- @cost O(1) | 1 luabind (draftsman:id) only when the hit has an attacker object
local function _apply_dealt_scale(shit)
    local attacker = shit.draftsman
    local mult = attacker and _hit_power_dealt[attacker:id()]
    if mult then shit.power = shit.power * mult end
    return mult
end

-- Victim is a monster: apply dealt (alpha attacker), taken (alpha victim), and panic immunity (alpha victim, own toggle).
-- set_custom_panic_threshold(0) stops the alpha fleeing; applied once per object lifetime, re-applied after loads (_panic_applied resets with the VM).
-- @cost O(1) | pure-Lua early-out when no alphas are alive; 1-2 luabind on an alpha-involved hit
local function _on_monster_before_hit(monster, shit, _bone_id, _flags)
    if next(_alpha_ids) == nil then return end
    local dealt = _apply_dealt_scale(shit)
    local victim_id = monster:id()
    local taken = _hit_power_taken[victim_id]
    if taken then shit.power = shit.power * taken end
    if cfg.mutator_alpha_panic_immunity_enabled and _alpha_ids[victim_id] and not _panic_applied[victim_id] then
        monster:set_custom_panic_threshold(0)
        _panic_applied[victim_id] = true
    end
    if (dealt or taken) and ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s monster_hit victim=%d dealt=%s taken=%s power=%.3f",
            LOG, victim_id, tostring(dealt), tostring(taken), shit.power)
    end
end

-- Victim is a stalker NPC: dealt only (stalkers are never alphas).
-- @cost O(1) | pure-Lua early-out when no alphas are alive
local function _on_npc_before_hit(npc, shit, _bone_id, _flags)
    if next(_alpha_ids) == nil then return end
    local dealt = _apply_dealt_scale(shit)
    if dealt and ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s npc_hit victim=%d dealt=%.3f power=%.3f", LOG, npc:id(), dealt, shit.power)
    end
end

-- Victim is the actor: dealt only, behind the vs-player toggle.
-- Note the seam's own signature: no victim arg, the actor is implicit.
-- @cost O(1) | pure-Lua early-outs when disabled or no alphas are alive
local function _on_actor_before_hit(shit, _bone_id, _flags)
    if not cfg.mutator_alpha_vs_player then return end
    if next(_alpha_ids) == nil then return end
    local base = shit.power
    local dealt = _apply_dealt_scale(shit)
    if dealt and ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s actor_hit dealt=%.3f base=%.3f -> power=%.3f (+%.1f%%)",
            LOG, dealt, base, shit.power, (dealt - 1) * 100)
    end
end

-- Inject trophy loot into a dead alpha's mutant-loot table: the species hide plus (level - 1) draws from the species parts pool.
-- Or level draws when the species has no hide; one guaranteed trophy per kill, more at higher levels, never a pelt stack.
-- @cost O(level) | 1 tracker lookup + species resolve on a dead alpha; 1 hash miss otherwise
local function _on_monster_loot_init(victim, loot_table)
    if not victim or not loot_table then return end
    if not cfg.mutator_alpha_loot_enabled then return end
    local level = ap_ext_tracker.get_alpha_level(victim:id())
    if level < 1 then return end
    local species = xcreature.get_mutant_species(victim:id())
    local pool = species and ALPHA_LOOT[species]
    if not pool then return end
    local parts = pool.parts
    local start_i = 1
    if pool.hide then
        if not loot_table[pool.hide] then loot_table[pool.hide] = { count = 0 } end
        loot_table[pool.hide].count = loot_table[pool.hide].count + 1
        start_i = 2
    end
    for _ = start_i, level do
        local section = parts[math_random(#parts)]
        if not loot_table[section] then loot_table[section] = { count = 0 } end
        loot_table[section].count = loot_table[section].count + 1
    end
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s alpha_loot id=%d species=%s level=%d", LOG, victim:id(), species, level)
    end
end

-- Fresh game object for a monster: earlier particles died with the old object, so forget the stale mark and re-attach if it is an alpha.
-- Covers game load and every offline->online transition.
-- @cost O(1) | pure-Lua for non-alphas
local function _on_monster_net_spawn(obj, _se_obj)
    local id = obj:id()
    _marks[id] = nil
    if _alpha_ids[id] then _try_apply_mark(id) end
end

-- Stop the mark the moment the alpha dies -- otherwise the corpse keeps emitting.
-- @cost O(1) | pure-Lua for unmarked monsters
local function _on_monster_death(victim, _who)
    if victim then _stop_mark(victim:id()) end
end

-- Drop all effect state for an id; blind hash deletes, safe for non-alphas.
-- The prompt path against id recycling (freed server ids are pooled), mirroring ap_ext_tracker's unregister clearing.
local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    _alpha_ids[id] = nil
    _hit_power_dealt[id] = nil
    _hit_power_taken[id] = nil
    _panic_applied[id] = nil
    _marks[id] = nil
end

-- Rebuild every effect from the tracker's live alpha registry (after load, on option change); sliders/toggles recompute.
-- _marks survives the reset on purpose (live particles need the stored name+bone to stop); non-alpha or toggle-off marks are pruned.
local function _build_state()
    local was_panic = _panic_applied
    _alpha_ids = {}
    _hit_power_dealt = {}
    _hit_power_taken = {}
    _panic_applied = {}
    for id, data in pairs(ap_ext_tracker.get_alphas()) do
        set_alpha_effects(id, data.level)
    end
    for id in pairs(_marks) do
        if not _alpha_ids[id] or not cfg.mutator_alpha_mark_enabled then _stop_mark(id) end
    end
    for id in pairs(was_panic) do
        if not (cfg.mutator_alpha_panic_immunity_enabled and _alpha_ids[id]) then
            local obj = xobject.get_go(id)
            if obj then obj:set_default_panic_threshold() end
        end
    end
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("%s rebuild: %d alphas, %d marked", LOG, xtable.get_count(_alpha_ids), xtable.get_count(_marks))
    end
end

function on_game_start()
    _alpha_ids = {}
    _hit_power_dealt = {}
    _hit_power_taken = {}
    _panic_applied = {}
    _marks = {}
    RegisterScriptCallback(CALLBACK.MONSTER_ON_NET_SPAWN, _on_monster_net_spawn)
    RegisterScriptCallback(CALLBACK.MONSTER_ON_DEATH_CALLBACK, _on_monster_death)
    RegisterScriptCallback(CALLBACK.MONSTER_ON_BEFORE_HIT, _on_monster_before_hit)
    RegisterScriptCallback(CALLBACK.NPC_ON_BEFORE_HIT, _on_npc_before_hit)
    RegisterScriptCallback(CALLBACK.ACTOR_ON_BEFORE_HIT, _on_actor_before_hit)
    RegisterScriptCallback(CALLBACK.MONSTER_ON_LOOT_INIT, _on_monster_loot_init)
    RegisterScriptCallback(CALLBACK.SERVER_ENTITY_ON_UNREGISTER, _on_entity_unregister)
    RegisterScriptCallback(CALLBACK.ACTOR_ON_FIRST_UPDATE, _build_state)
    RegisterScriptCallback(CALLBACK.ON_OPTION_CHANGE, _build_state)
    ap_core_debug.info("%s Initialized", LOG)
end
