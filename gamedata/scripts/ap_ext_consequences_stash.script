--- ap_ext_consequences_stash: STASH family consequences (loot + ambush + fill). LTX policy.
---
--- Policy loaded from `configs/alifeplus/ap_stash_policy.ltx`. Single uniform block (no per-rank).
--- Each entry lists every reachable category with {min, max}. Loot fills any entry where squad
--- count < min by taking matching stash sections; fill deposits items where squad count > max.
--- extras_max: top-N by cost from sections NOT taken by category pass (the "valuable" pick).
--- fill_max: per-event total deposit cap.
---
--- Untouchable preservation: any section classified as "untouchable" (quest / anim / blacklisted)
--- in the stash forces a whole-stash skip (no loot, no clear). Quest items always survive.
---
--- Crafting preservation: MCM toggle `consequence_stash_loot_skip_crafting` skips the whole
--- stash when any tool / part / upgrade section is present.
---
--- Ammo categories (ammo_slot_*_t*) loot via per-member resolution: each stash ammo section
--- is matched against `_collect_squad_counts`'s member_opts to find an owner whose pistol or rifle takes
--- that round. Section-only resolution (`get_section_category`) is used for non-ammo entries.

local string_sub = string.sub
local table_concat, table_sort = table.concat, table.sort
local xobject, xtime, xstash, xinventory, xprofiler, xtrace = xobject, xtime, xstash, xinventory, xprofiler, xtrace
local ap_core_debug, ap_core_broker, ap_core_record, ap_core_consumer, ap_ext_tracker = ap_core_debug, ap_core_broker, ap_core_record, ap_core_consumer, ap_ext_tracker

local CAUSE = ap_core_const.CAUSE
local RESULT = ap_core_const.RESULT
local REASON = ap_core_const.REASON
local CONSEQUENCE = ap_core_const.CONSEQUENCE
local ACTION = ap_core_const.ACTION
local CAUSE_CATEGORY = ap_core_const.CAUSE_CATEGORY
local PRE_RELEASE_GULAG = ap_core_const.PRE_RELEASE_GULAG

local LOG_INIT = ap_core_debug.format_bracket(CAUSE_CATEGORY.OPPORTUNITIES)
local LOG_LOOT = ap_core_debug.format_bracket(CONSEQUENCE.STASH_LOOT)
local LOG_AMBUSH = ap_core_debug.format_bracket(CONSEQUENCE.STASH_AMBUSH)
local LOG_FILL = ap_core_debug.format_bracket(CONSEQUENCE.STASH_FILL)

local cfg = ap_core_mcm.cfg

local POLICY_PATH    = "alifeplus\\ap_stash_policy.ltx"
local POLICY_SECTION = "ap_stash_policy"
local DEFAULT_COST   = ap_core_const.DEFAULT_TRADE_COST

-- Populated by _load_stash_policy at on_game_start. Shape:
--   { entries = { { category, rule = {min, max} }, ... },
--     rules   = { [category] = { min, max }, ... },
--     extras_max = N, fill_max = N }
local STASH_POLICY = nil

-- Load stash policy via xinventory.load_policy (shared LTX shape across trade / stash /
-- inventory-balance). Adapts the {entries, rules, specials} block into the {entries,
-- rules, extras_max, fill_max} shape the stash callers already use.
local function _load_stash_policy()
    local block = xinventory.load_policy(POLICY_PATH, { POLICY_SECTION },
        { extras_max = true, fill_max = true })[POLICY_SECTION]
    STASH_POLICY = {
        entries    = block.entries,
        rules      = block.rules,
        extras_max = block.specials.extras_max or 0,
        fill_max   = block.specials.fill_max or 0,
    }
end

local function _has_untouchable(sections)
    for i = 1, #sections do
        if xinventory.is_in_category(sections[i], "untouchable") then return true end
    end
    return false
end

local function _has_crafting(sections)
    for i = 1, #sections do
        if xinventory.is_in_category(sections[i], "crafting") then return true end
    end
    return false
end

-- Per-squad-member iterate handler: counts items by policy key into `counts` using member's opts.
-- policy_key keys an item under its section when the policy names that section, else its category
-- (and drops untouchable / equipped). An item the policy never names has no key in counts, so it
-- is invisible to fill / loot -- that is how smoke stays out of stashes (it is simply unlisted).
-- @cost O(items_in_inventory) | per item: 1 policy_key call (cached chain hits in xinventory)
local function _collect_member_counts(member_se, member_ids, _opts_out, counts)
    local member_id = member_se.id
    member_ids[#member_ids + 1] = member_id
    local npc_go = xobject.get_go(member_id)
    if not npc_go then return end
    local opts = xinventory.get_category_opts(npc_go)
    _opts_out[member_id] = opts
    local rules = STASH_POLICY.rules
    xinventory.iterate_inventory(member_id, function(_, item)
        local key = xinventory.get_policy_key(item, opts, rules)
        if key then counts[key] = (counts[key] or 0) + 1 end
    end)
end

-- Walk squad members. Returns (member_ids, member_opts, counts) where counts is {[category]=n}.
-- member_ids covers online + offline via squad_members iterator (preserves round-robin shape).
-- member_opts is populated for ONLINE members only (xobject.get_go is nil for offline).
local function _collect_squad_counts(squad)
    local member_ids, member_opts, counts = {}, {}, {}
    if not squad or not squad.squad_members then return member_ids, member_opts, counts end
    if squad:npc_count() == 0 then return member_ids, member_opts, counts end
    for member_se in squad:squad_members() do
        _collect_member_counts(member_se, member_ids, member_opts, counts)
    end
    return member_ids, member_opts, counts
end

-- Index stash sections with cost + a `taken` flag, for the two loot passes.
local function _build_cost_index(sections)
    local idx = {}
    for i = 1, #sections do
        idx[i] = { sec = sections[i], cost = xinventory.get_cost(sections[i]) or DEFAULT_COST, taken = false }
    end
    return idx
end

local function _is_ammo_slot_category(cat)
    return string_sub(cat, 1, 10) == "ammo_slot_"
end

-- Match an untaken stash section to a non-ammo policy key. A stash section resolves the same
-- way an item does: its own section name when the policy names that section, else its category.
local function _find_category_section(index, key, rules)
    for j = 1, #index do
        local sec = index[j].sec
        local sec_key = (rules and rules[sec]) and sec or xinventory.get_section_category(sec)
        if not index[j].taken and sec_key == key then return j end
    end
    return nil
end

-- Walk members starting from the rotating cursor and return the first member whose
-- equipped pistol or rifle accepts the given ammo section under category `cat`. Returns
-- nil when no equipped weapon matches.
local function _find_section_member(section, cat, member_ids, member_opts, cursor)
    local m_count = #member_ids
    for k = 0, m_count - 1 do
        local m_idx = ((cursor - 1 + k) % m_count) + 1
        local m_id = member_ids[m_idx]
        local opts = member_opts[m_id]
        if opts and xinventory.resolve_ammo_category(section, opts) == cat then
            return m_id
        end
    end
    return nil
end

-- Per-member ammo match. Walks stash sections; for each untaken section, tries to match
-- it to a member's equipped weapons via _find_section_member starting from the
-- rotating cursor. Returns (section_idx, member_id) of the first hit.
local function _find_category_ammo_section(index, cat, member_ids, member_opts, cursor)
    for j = 1, #index do
        if not index[j].taken then
            local m_id = _find_section_member(index[j].sec, cat, member_ids, member_opts, cursor)
            if m_id then return j, m_id end
        end
    end
    return nil, nil
end

-- Resolve one stash candidate for an entry: returns (section_idx, owner_id) or nil/nil.
-- Ammo categories route per-member; non-ammo use section-only resolution.
local function _resolve_candidate(is_ammo, entry, ctx, cursor)
    if is_ammo then
        return _find_category_ammo_section(ctx.index, entry.category, ctx.member_ids, ctx.member_opts, cursor)
    end
    return _find_category_section(ctx.index, entry.category, ctx.rules), ctx.member_ids[cursor]
end

-- Fill ONE policy entry's min target by taking matching sections from stash. Returns
-- updated cursor. ctx carries non-mutated per-loot state { index, member_ids,
-- member_opts, counts, taken_secs, rules }.
local function _run_loot_entry(entry, ctx, cursor)
    if entry.rule.min <= 0 then return cursor end
    local cat = entry.category
    local current = ctx.counts[cat] or 0
    local is_ammo = _is_ammo_slot_category(cat)
    while current < entry.rule.min do
        local found_at, owner_id = _resolve_candidate(is_ammo, entry, ctx, cursor)
        if not found_at then break end
        if not xinventory.create_item(ctx.index[found_at].sec, owner_id) then break end
        ctx.index[found_at].taken = true
        current = current + 1
        ctx.counts[cat] = current
        cursor = (cursor % #ctx.member_ids) + 1
        ctx.taken_secs[#ctx.taken_secs + 1] = ctx.index[found_at].sec
    end
    return cursor
end

-- Per-category loot pass. Walk policy entries in declaration order; delegates each entry to _run_loot_entry.
local function _run_category_loot(ctx)
    local cursor = 1
    for i = 1, #STASH_POLICY.entries do
        cursor = _run_loot_entry(STASH_POLICY.entries[i], ctx, cursor)
    end
end

-- Extras pass. Top-N by cost from sections not taken by the category pass.
local function _run_loot_extras(index, member_ids, taken_secs)
    if STASH_POLICY.extras_max <= 0 then return end
    local leftover = {}
    for i = 1, #index do
        if not index[i].taken then leftover[#leftover + 1] = index[i] end
    end
    table_sort(leftover, function(a, b) return a.cost > b.cost end)
    local cursor, taken = 1, 0
    for i = 1, #leftover do
        if taken >= STASH_POLICY.extras_max then break end
        if xinventory.create_item(leftover[i].sec, member_ids[cursor]) then
            leftover[i].taken = true
            cursor = (cursor % #member_ids) + 1
            taken = taken + 1
            taken_secs[#taken_secs + 1] = leftover[i].sec
        end
    end
end

--- Loot a stash. Three-stage gate:
---   1. Untouchable in stash -> skip whole stash (no loot, no clear). Always-on.
---   2. Crafting in stash AND MCM toolkit-skip on -> skip whole stash (preserve toolkits).
---   3. Otherwise: per-category loot pass + extras pass + clear stash.
local function _on_arrive_loot(squad, args)
    if not args then return end
    ap_ext_tracker.reset_squad_opportunity(squad.id, args.dto_field, xtime.get_game_sec())
    local stash_id = args.stash_id
    if xstash.is_stash_looted(stash_id) then
        ap_core_debug.debug(LOG_LOOT .. " arrive: stash=%d already looted", stash_id)
        return
    end
    local sections = xstash.get_stash_items(stash_id)
    if not sections or #sections == 0 then return end

    -- Untouchable preservation (always-on; quest items must survive)
    if _has_untouchable(sections) then
        ap_core_debug.debug(LOG_LOOT .. " arrive: stash=%d squad=%d untouchable_present, skipping", stash_id, squad.id)
        return
    end

    -- Crafting preservation (MCM-gated)
    if cfg.consequence_stash_loot_skip_crafting and _has_crafting(sections) then
        ap_core_debug.debug(LOG_LOOT .. " arrive: stash=%d squad=%d crafting_present, skipping", stash_id, squad.id)
        return
    end

    local cmd_id = squad:commander_id()
    local st = cmd_id and db.storage[cmd_id]
    if not st or st.object == nil then
        ap_core_debug.debug(LOG_LOOT .. " arrive: stash=%d squad=%d commander_offline, clearing stash", stash_id, squad.id)
        xstash.collect_stash_items(stash_id)
        return
    end

    local member_ids, member_opts, counts = _collect_squad_counts(squad)
    if #member_ids == 0 then
        ap_core_debug.debug(LOG_LOOT .. " arrive: stash=%d squad=%d no_members, clearing stash", stash_id, squad.id)
        xstash.collect_stash_items(stash_id)
        return
    end

    local dbg = ap_core_debug.is_enabled()
    local tid = dbg and xtrace.new().id or 0
    local tmr = xprofiler.new_if(dbg):start()
    local taken_secs = {}
    local index = _build_cost_index(sections)
    _run_category_loot({
        index       = index,
        member_ids  = member_ids,
        member_opts = member_opts,
        counts      = counts,
        taken_secs  = taken_secs,
        rules       = STASH_POLICY.rules,
    })
    _run_loot_extras(index, member_ids, taken_secs)
    xstash.collect_stash_items(stash_id)
    tmr:stop()
    if dbg then
        ap_core_debug.debug("%s [tid=%d] complete stash=%d squad=%d taken=%d items=%d looted=%s [%.2fms]", LOG_LOOT, tid,
            stash_id, squad.id, #taken_secs, #sections, table_concat(taken_secs, ","), tmr:get_ms())
    end
end

local function _on_arrive_ambush(squad, args)
    if not args then return end
    ap_core_debug.debug(LOG_AMBUSH .. " arrive: stash=%d squad=%d", args.stash_id, squad.id)
    ap_ext_tracker.reset_squad_opportunity(squad.id, args.dto_field, xtime.get_game_sec())
end

-- Per-member pick handler for fill pass. Mutates picks + surplus. Each item resolves to its
-- policy key (section if the policy names it, else category) so a deposit only happens for keys
-- with surplus -- an unlisted item (e.g. smoke) has no key in surplus and is never deposited.
local function _select_member_items(member_id, opts, surplus, picks, fill_max)
    local rules = STASH_POLICY.rules
    xinventory.iterate_inventory(member_id, function(_, item)
        if #picks >= fill_max then return end
        local key = xinventory.get_policy_key(item, opts, rules)
        if key and surplus[key] and surplus[key] > 0 then
            picks[#picks + 1] = item
            surplus[key] = surplus[key] - 1
        end
    end)
end

-- Per-category surplus computed from squad counts vs policy max. Capped at fill_max total.
local function _collect_fill_picks(squad, fill_max)
    local picks = {}
    if fill_max <= 0 then return picks end
    local member_ids, member_opts, counts = _collect_squad_counts(squad)
    if #member_ids == 0 then return picks end

    local surplus = xinventory.build_surplus_map(counts, STASH_POLICY.rules)

    for i = 1, #member_ids do
        if #picks >= fill_max then break end
        local member_id = member_ids[i]
        _select_member_items(member_id, member_opts[member_id], surplus, picks, fill_max)
    end
    return picks
end

--- Fill a stash. Deposit any category whose squad count exceeds policy max, total per-event
--- capped by STASH_POLICY.fill_max.
local function _on_arrive_fill(squad, args)
    if not args then return end
    ap_ext_tracker.reset_squad_opportunity(squad.id, args.dto_field, xtime.get_game_sec())
    local stash_id = args.stash_id

    local cmd_id = squad:commander_id()
    local st = cmd_id and db.storage[cmd_id]
    if not st or st.object == nil then
        ap_core_debug.debug(LOG_FILL .. " arrive: stash=%d squad=%d commander_offline", stash_id, squad.id)
        return
    end

    local dbg = ap_core_debug.is_enabled()
    local tid = dbg and xtrace.new().id or 0
    local tmr = xprofiler.new_if(dbg):start()
    local picks = _collect_fill_picks(squad, STASH_POLICY.fill_max)
    if #picks == 0 then
        tmr:stop()
        if dbg then ap_core_debug.debug("%s [tid=%d] complete stash=%d squad=%d no_items [%.2fms]", LOG_FILL, tid, stash_id, squad.id, tmr:get_ms()) end
        return
    end
    local secs = {}
    for i = 1, #picks do
        local itm = picks[i]
        secs[i] = xinventory.get_section(itm)
        xinventory.release_item(itm)
    end
    local ok = xstash.add_stash_items(stash_id, secs, false)
    tmr:stop()
    if not ok then
        ap_core_debug.warn(LOG_FILL .. " arrive: stash=%d squad=%d fill_failed", stash_id, squad.id)
        return
    end
    if dbg then
        ap_core_debug.debug("%s [tid=%d] complete stash=%d squad=%d items=%d deposited=%s [%.2fms]", LOG_FILL, tid,
            stash_id, squad.id, #secs, table_concat(secs, ","), tmr:get_ms())
    end
end

local CONFIGS = {
    { consequence = CONSEQUENCE.STASH_LOOT, action = ACTION.STASH_LOOT,     event = CAUSE.STASH_LOOT,
      name = "stash_loot",
      enabled_key = "consequence_stash_loot_enabled",
      on_arrive_fn = _on_arrive_loot,
      pre_release_gulag = PRE_RELEASE_GULAG.STASH_LOOT,
      interruptable = false },
    { consequence = CONSEQUENCE.STASH_AMBUSH, action = ACTION.STASH_AMBUSH, event = CAUSE.STASH_AMBUSH,
      name = "stash_ambush",
      enabled_key = "consequence_stash_ambush_enabled",
      on_arrive_fn = _on_arrive_ambush,
      pre_release_gulag = PRE_RELEASE_GULAG.STASH_AMBUSH,
      interruptable = true },
    { consequence = CONSEQUENCE.STASH_FILL, action = ACTION.STASH_FILL,     event = CAUSE.STASH_FILL,
      name = "stash_fill",
      enabled_key = "consequence_stash_fill_enabled",
      on_arrive_fn = _on_arrive_fill,
      pre_release_gulag = PRE_RELEASE_GULAG.STASH_FILL,
      interruptable = false },
}

local function _create_condition(enabled_key)
    return function() return cfg[enabled_key] end
end

local function _create_handler(entry)
    return function(event_data)
        local squad = xobject.get_se(event_data.squad_id)
        if not squad then return { code = RESULT.FAILED_SCAN, reason = REASON.NO_SQUAD } end
        local smart = xobject.get_se(event_data.dst_smart_id)
        if not smart then return { code = RESULT.FAILED_SCAN, reason = REASON.NO_SMART } end

        local res = ap_core_broker.register_squad(squad, smart, {
            rush = cfg["consequence_" .. entry.name .. "_rush"],
            on_arrive = entry.consequence,
            on_arrive_args = { stash_id = event_data.stash_id, dto_field = event_data.dto_field },
            pre_release_gulag = entry.pre_release_gulag,
            interruptable = entry.interruptable,
        })
        if res.code ~= RESULT.SUCCESS then
            return { code = RESULT.FAILED_ACTION, reason = res.reason or REASON.MOVE_FAILED }
        end
        ap_core_record.add_record(squad, event_data.cause, entry.consequence, {
            action_key = entry.action,
            smart = smart, level_id = event_data.level_id,
        })
        return { code = RESULT.SUCCESS }
    end
end

function on_game_start()
    _load_stash_policy()
    for i = 1, #CONFIGS do
        local entry = CONFIGS[i]
        ap_core_consumer.register(entry.consequence, {
            event = entry.event,
            condition = _create_condition(entry.enabled_key),
            on_arrive = entry.on_arrive_fn,
        }, _create_handler(entry))
    end
    ap_core_debug.info(LOG_INIT .. " Initialized: 3 consequences (loot, ambush, fill)")
end
