--- ap_core_debug: Logger, bracket helper, MCM log-level, periodic diagnostics dump.
--- Loads before ap_core_mcm so the mcm namespace is read lazily inside on_game_start
--- (module-top alias would capture nil at load time).
local pairs, tostring, table_sort, table_concat = pairs, tostring, table.sort, table.concat
local RegisterScriptCallback = RegisterScriptCallback
local xsmart, xsquad, xlevel, xlog = xsmart, xsquad, xlevel, xlog
local CALLBACK = ap_core_const.CALLBACK

local DIAG_INTERVAL_SEC = 60
local DIAG_TIMER_EV = "ap_diag"
local DIAG_TIMER_ID = "dump"

local log = xlog.get_logger("AP", { outfile = "alifeplus.log", level = "WARN" })
-- Level constants for the flush-on-emit flag (init_log_level). TRACE = flush every line, ERROR =
-- the logger's own default flush threshold (xlog buffers below it).
local _log_levels = xlog.get_levels()

function enabled()
    return log.get_level() >= 5
end

function bracket(c)
    local label = c:upper():gsub(":", ".")
    return "[" .. label .. "]"
end

function info(fmt, ...)
    log.info(fmt, ...)
end

function warn(fmt, ...)
    log.warn(fmt, ...)
end

-- named err to avoid shadowing Lua built-in error()
function err(fmt, ...)
    log.error(fmt, ...)
end

function debug(fmt, ...)
    if not enabled() then return end
    log.debug(fmt, ...)
end

--- Read MCM log_level and apply to the xlog logger. Idempotent; safe to call any
--- number of times. Exposed so modules whose actor_on_first_update handler runs
--- before this module's can ensure the level is set before they emit DEBUG/INFO.
--- @safety SAFE - nil-guarded; falls back to "WARN" if MCM not loaded yet
--- @cost O(1) | 0 luabind (set_level + flush_on_level are pure Lua field sets)
function init_log_level()
    local level = ap_core_mcm and ap_core_mcm.get_config and ap_core_mcm.get_config("log_level") or "WARN"
    log.set_level(level)
    local flush = ap_core_mcm and ap_core_mcm.get_config and ap_core_mcm.get_config("log_flush") or false
    log._logger.flush_on_level = flush and _log_levels.TRACE or _log_levels.ERROR
end

local function _log_mcm_settings()
    local parts = {}
    local mcm = ap_core_mcm.cfg
    for key, _ in pairs(ap_core_mcm.defaults) do
        parts[#parts+1] = key .. "=" .. tostring(mcm[key])
    end
    table_sort(parts)
    log.debug("[MCM] %s", table_concat(parts, " "))
end

-- Periodic [CORE.DIAG] dump of smarts (filtered to actor level) and squads.
-- Gated by enabled(); xsmart.dump_smarts and xsquad.dump_squads use cached role lookups.
-- @cost O(smarts+squads) per fire (60s) | per smart: 1 heavy + role walk; per squad: 4-5 luabind + cached role
local function _diag_dump()
    if not enabled() then return end
    local sim = alife()
    local actor_se = sim and sim:actor()
    local level_id = actor_se and xlevel.get_level_id(actor_se) or nil
    log.debug("[CORE.DIAG] %s", xsmart.dump_smarts(level_id))
    log.debug("[CORE.DIAG] %s", xsquad.dump_squads(level_id))
end

local function _on_diag_timer()
    _diag_dump()
    ResetTimeEvent(DIAG_TIMER_EV, DIAG_TIMER_ID, DIAG_INTERVAL_SEC)
end

local function _on_first_update()
    init_log_level()
    _log_mcm_settings()
end

function on_game_start()
    RegisterScriptCallback(CALLBACK.ON_OPTION_CHANGE, init_log_level)
    RegisterScriptCallback(CALLBACK.ACTOR_ON_FIRST_UPDATE, _on_first_update)
    CreateTimeEvent(DIAG_TIMER_EV, DIAG_TIMER_ID, DIAG_INTERVAL_SEC, _on_diag_timer)
end
