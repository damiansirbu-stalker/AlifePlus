--- ap_ext_smart_mutator: Smart-terrain mutations (conquest/swarm/infest); descriptor lifecycle inject/re-apply/decay/save; conquest grows a mini-base outpost.

local pairs, next, type, tonumber, tostring, RegisterScriptCallback = pairs, next, type, tonumber, tostring, RegisterScriptCallback
local math_floor, math_random, string_match, string_sub, string_format = math.floor, math.random, string.match, string.sub, string.format
local xobject, xsmart, xsmart_spawn, xtime, xprofiler = xobject, xsmart, xsmart_spawn, xtime, xprofiler
local xsquad, xcreature, xinventory, xevent, xpda, get_object_squad = xsquad, xcreature, xinventory, xevent, xpda, get_object_squad

local CALLBACK = ap_core_const.CALLBACK
local cfg = ap_core_mcm.cfg
-- Outpost service sidearm: fixed base-game sections, given at creation (offline-capable).
local SERVICE_WEAPON = "wpn_pm"
local SERVICE_AMMO = "ammo_9x18_fmj"
local SERVICE_AMMO_ROUNDS = 30
-- Field-merchant rank; vanilla service profiles roll a hub-VIP rank (corrected by _set_service_rank).
local SERVICE_RANK = 0

local CONQUEST_KEY = "ap_conquest"
local SWARM_KEY = "ap_swarm"
local INFEST_KEY = "ap_infest"

local TIMER_EV = "ap_ext_smart_mutator"
local SCAN_ID = "mutation_scan"
local SCAN_INTERVAL_SEC = 60

--- Species allowed to take territory (pack/lair creatures); public, gates swarm and infest.
INFEST_SPECIES = {
    bloodsucker = true, snork = true, cat = true, dog = true, pseudodog = true, psy_dog = true,
    lurker = true, psysucker = true, fracture = true, boar = true,
}

--- Mutation type names (public: cause-side gates key is_taken by these).
MUT_CONQUEST = "conquest"
MUT_SWARM = "swarm"
MUT_INFEST = "infest"

-- Per-faction trader trade configs; barman/medic/mechanic use the generic configs.
local TRADE_PATH = "items\\trade\\"
local TRADER_CFG = {
    army = "trade_military", bandit = "trade_bandit", csky = "trade_csky_spore", dolg = "trade_duty",
    ecolog = "trade_ecolog_sakharov", freedom = "trade_freedom", killer = "trade_mercenary",
    monolith = "trade_monolith", stalker = "trade_stalker_owl", renegade = "trade_renegade",
    greh = "trade_greh", isg = "trade_isg",
}
local ROLE_CFG = {
    barman = "trade_generic_barman", medic = "trade_generic_medic", mechanic = "trade_generic_mechanic",
}
local SERVICE_ROLES = { "trader", "barman", "mechanic", "medic" }
local _ROLE_SET = { trader = true, barman = true, mechanic = true, medic = true }
local SERVICE_KEY_PREFIX = "ap_service_"
-- Guard detail respawn row key: pinned faction combat squads, no trade or icon, only the pin.
local GUARD_KEY = "ap_guard"
-- Service suitability floor: needs squad room plus a campfire or surge-shelter anchor.
local SERVICE_MIN_MAX_POP = 1
-- Generic trade assortment (xr_logic.script:113); an unmade leftover service is re-inited to it.
local GENERIC_TRADE = "items\\trade\\trade_generic.ltx"
-- Engine PDA role spots (stalker_generic.script:98-126); the scan re-adds after a scheme reset.
local SERVICE_ICON = {
    trader   = { icon = "ui_pda2_trader_location",   hint = "st_ui_pda_legend_trader" },
    barman   = { icon = "ui_pda2_barman_location",   hint = "st_ui_pda_legend_barman" },
    mechanic = { icon = "ui_pda2_mechanic_location", hint = "st_ui_pda_legend_mechanic" },
    medic    = { icon = "ui_pda2_medic_location",    hint = "st_ui_pda_legend_medic" },
}

-- respawn_params key for a service role ("ap_service_trader"); one key per role so decay is per-role.
local function _get_service_key(role) return SERVICE_KEY_PREFIX .. role end
-- squad_descr section a service role spawns for a faction ("ap_service_duty_trader").
local function _get_service_section(faction, role) return SERVICE_KEY_PREFIX .. faction .. "_" .. role end
-- trade config path for (faction, role); trader is per-faction, others generic. nil if no config.
local function _get_role_cfg_path(faction, role)
    local name = (role == "trader") and TRADER_CFG[faction] or ROLE_CFG[role]
    return name and (TRADE_PATH .. name .. ".ltx") or nil
end
-- role from a service respawn key ("ap_service_trader" -> "trader"); nil if not a service key.
local function _parse_role(prop)
    if type(prop) ~= "string" then return nil end
    local role = prop:match("^ap_service_(%a+)$")
    return (role and _ROLE_SET[role]) and role or nil
end

-- Live per-type mutation state; conquest entries carry the outpost plan (.services, .guards).
local _state = { conquest = {}, swarm = {}, infest = {} }
local _pending = {}
local _decay_collector = {}
-- Pinned outpost squads: squad_id -> { smart_id, smart_name, section, role, held_at, stocked }.
local _held_squads = {}
local _held_pending = nil
local _hold_drop_collector = {}
-- Per-smart ephemeral game-sec clock for the mutator's own respawn cadence (never saved).
local _respawn_stamp = {}

--- True when the smart terrain holds a live infest entry.
--- @param smart_id number
--- @return boolean
function is_infested(smart_id)
    return smart_id and _state.infest[smart_id] ~= nil
end

--- True if a smart holds a live mutation entry other than (mut_name, identity): another type or identity.
--- The takeover exclusion gate; nil mut_name treats every live entry as other.
--- @param smart_id number
--- @param mut_name string|nil MUT_CONQUEST / MUT_SWARM / MUT_INFEST
--- @param identity string|nil Faction or species holding the claim
--- @return boolean
function is_taken(smart_id, mut_name, identity)
    if not smart_id then return false end
    for name, tbl in pairs(_state) do
        local entry = tbl[smart_id]
        if entry and (name ~= mut_name or entry.faction ~= identity) then return true end
    end
    return false
end

--- Count live conquest entries a faction holds on a level: the conquest cause's hold-ceiling meter.
--- @param faction string Stalker community
--- @param level_id number
--- @return number
function get_conquest_count(faction, level_id)
    if not faction or not level_id then return 0 end
    local count = 0
    for _, data in pairs(_state.conquest) do
        if data.faction == faction and data.level_id == level_id then count = count + 1 end
    end
    return count
end

--- Count live swarm entries on a level, all species.
--- Mutants hold territory as a class, so the hold ceiling meters the class, not one species.
--- @param level_id number
--- @return number
function get_swarm_count(level_id)
    if not level_id then return 0 end
    local count = 0
    for _, data in pairs(_state.swarm) do
        if data.level_id == level_id then count = count + 1 end
    end
    return count
end

--- True when the per-level infest cap allows another infestation.
--- @param level_id number
--- @return boolean
function can_infest_on_level(level_id)
    if not level_id then return false end
    local count = 0
    for _, data in pairs(_state.infest) do
        if data.level_id == level_id then
            count = count + 1
            if count >= cfg.mutator_area_infest_max_per_level then return false end
        end
    end
    return true
end

-- One descriptor per mutation type: the apply/clear calls, refresh vs reject, cap, and save keys.
local MUTATIONS = {
    conquest = {
        name = MUT_CONQUEST, key = CONQUEST_KEY, id_word = "faction", refresh = true, grows_services = true,
        apply = xsmart_spawn.set_exclusive_spawn_tiered, clear = xsmart_spawn.clear_exclusive_spawn,
        mutate_cfg = "mutator_area_conquest_mutate_smart",
        decay_cfg = "mutator_area_conquest_decay_hours",
        num_cfg = "mutator_area_conquest_spawn_num",
        respawn_idle_cfg = "mutator_area_conquest_respawn_minutes",
        ts_field = "conquered_at", save_key = "conquered_smarts",
    },
    swarm = {
        name = MUT_SWARM, key = SWARM_KEY, id_word = "species", refresh = true, allow = INFEST_SPECIES,
        apply = xsmart_spawn.set_exclusive_spawn, clear = xsmart_spawn.clear_exclusive_spawn,
        mutate_cfg = "mutator_area_swarm_mutate_smart",
        decay_cfg = "mutator_area_swarm_decay_hours",
        num_cfg = "mutator_area_swarm_spawn_num",
        respawn_idle_cfg = "mutator_area_swarm_respawn_minutes",
        ts_field = "swarmed_at", save_key = "swarmed_smarts",
    },
    infest = {
        name = MUT_INFEST, key = INFEST_KEY, id_word = "faction", refresh = false, cap = can_infest_on_level, allow = INFEST_SPECIES,
        apply = xsmart_spawn.set_exclusive_spawn, clear = xsmart_spawn.clear_exclusive_spawn,
        mutate_cfg = "mutator_area_infest_mutate_smart",
        decay_cfg = "mutator_area_infest_decay_hours",
        num_cfg = "mutator_area_infest_spawn_num",
        respawn_idle_cfg = "mutator_area_infest_respawn_minutes",
        ts_field = "infested_at", save_key = "infested_smarts",
    },
}

-- respawn_point_prop_section -> descriptor, for the deferred spawn trace.
local _mut_by_key = {}
for _, mut in pairs(MUTATIONS) do _mut_by_key[mut.key] = mut end

-- Settle a hit against existing state: refresh a same-identity re-hit; reject a non-refresh re-hit or taken smart.
-- Returns "refreshed"/"rejected", or nil when _apply_mutation does a fresh apply.
local function _resolve_entry(mut, existing, smart_id, identity, now)
    if mut.refresh and existing and existing.faction == identity then
        existing[mut.ts_field] = now
        ap_core_debug.debug("[MUTATOR.SMART] %s: smart=%d %s=%s (refresh)", mut.name, smart_id, mut.id_word, identity)
        return "refreshed"
    end
    if not mut.refresh and existing then
        ap_core_debug.debug("[MUTATOR.SMART] %s: smart=%d %s=%s rejected (already present)", mut.name, smart_id, mut.id_word, identity)
        return "rejected"
    end
    if is_taken(smart_id, mut.name, identity) then
        ap_core_debug.debug("[MUTATOR.SMART] %s: smart=%d %s=%s rejected (taken)", mut.name, smart_id, mut.id_word, identity)
        return "rejected"
    end
    return nil
end

-- Forward declaration: _build_plan is defined with the outpost section below (needs the cap meters).
local _build_plan

-- Inject or refresh one mutation on a smart; true on apply/refresh, false on a gate reject.
-- A conquest also rolls its outpost plan once here (_build_plan); the scan re-writes the rows.
-- @cost O(1) | 1 luabind (xobject.get_se) on a real inject
local function _apply_mutation(mut, smart_id, identity, level_id)
    if not smart_id or not identity or not level_id then return false end
    if not cfg or not cfg[mut.mutate_cfg] then return false end
    local tbl = _state[mut.name]
    local now = xtime.get_game_sec()
    local handled = _resolve_entry(mut, tbl[smart_id], smart_id, identity, now)
    if handled then return handled == "refreshed" end
    if mut.allow and not mut.allow[identity] then
        ap_core_debug.debug("[MUTATOR.SMART] %s: smart=%d %s=%s rejected (not in allowlist)", mut.name, smart_id, mut.id_word, identity)
        return false
    end
    if mut.cap and not mut.cap(level_id) then
        ap_core_debug.debug("[MUTATOR.SMART] %s: smart=%d %s=%s rejected (level cap)", mut.name, smart_id, mut.id_word, identity)
        return false
    end
    local smart = xobject.get_se(smart_id)
    if not smart then return false end
    if not mut.apply(smart, mut.key, identity, cfg[mut.num_cfg]) then
        ap_core_debug.debug("[MUTATOR.SMART] %s: smart=%d %s=%s FAILED (unknown %s)", mut.name, smart_id, mut.id_word, identity, mut.id_word)
        return false
    end
    local entry = { faction = identity, level_id = level_id, [mut.ts_field] = now }
    if mut.grows_services then _build_plan(entry, smart_id) end
    tbl[smart_id] = entry
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("[MUTATOR.SMART] %s: smart=%d %s=%s level=%d base=%s", mut.name, smart_id, mut.id_word, identity, level_id, tostring(xsmart.is_base(smart)))
    end
    return true
end

--- Conquer a smart with an exclusive faction spawn injection (sole ownership).
--- Refreshes a same-faction re-hit; re-conquers (overwrites) a different faction.
--- @param smart_id number
--- @param faction string Stalker community
--- @param level_id number
--- @return boolean
function apply_conquest(smart_id, faction, level_id)
    return _apply_mutation(MUTATIONS.conquest, smart_id, faction, level_id)
end

--- Swarm a smart with an exclusive mutant-species spawn injection (sole ownership).
--- Refreshes a same-species re-hit; re-swarms (overwrites) a different species.
--- @param smart_id number
--- @param species string Mutant species
--- @param level_id number
--- @return boolean
function apply_swarm(smart_id, species, level_id)
    return _apply_mutation(MUTATIONS.swarm, smart_id, species, level_id)
end

--- Infest a smart with an exclusive spawn injection.
--- Rejects a second infest on the same smart and obeys the per-level cap.
--- @param smart_id number
--- @param faction string Mutant species / faction
--- @param level_id number
--- @return boolean
function apply_infest(smart_id, faction, level_id)
    return _apply_mutation(MUTATIONS.infest, smart_id, faction, level_id)
end

-- Count squads currently stationed at a smart (SIMBOARD occupancy). Trace/diagnostic use only.
-- @cost O(k) stationed squads | 0 luabind (pure Lua hash walk on SIMBOARD.smarts)
local function _get_smart_squad_count(smart_id)
    local squads = xsmart.get_smart_squads(smart_id)
    if not squads then return 0 end
    local count = 0
    for _ in pairs(squads) do count = count + 1 end
    return count
end

-- Outpost mini base: plan + rows + pins (conquest only)

-- Total PLANNED services across conquered smarts on a level (the per-map budget meter).
-- A planned role counts whether its NPC is currently alive or between respawns.
-- @cost O(n) conquered smarts * O(roles)
local function _get_service_count(level_id)
    local count = 0
    for _, data in pairs(_state.conquest) do
        if data.level_id == level_id and data.services then
            for _ in pairs(data.services) do count = count + 1 end
        end
    end
    return count
end

-- Count of one (faction, role) planned service across conquered smarts on a level (role-variety meter).
-- @cost O(n) conquered smarts
local function _get_faction_role_count(level_id, faction, role)
    local count = 0
    for _, data in pairs(_state.conquest) do
        if data.level_id == level_id and data.faction == faction and data.services and data.services[role] then
            count = count + 1
        end
    end
    return count
end

-- Live count of a (faction, role) on the level when eligible: has a trade config and is not taken.
-- Nil when ineligible; feeds the least-represented pick in _select_service_role.
-- @cost O(roles) * O(conquered) meter
local function _get_eligible_role_count(data, role, taken)
    if taken[role] or not _get_role_cfg_path(data.faction, role) then return nil end
    return _get_faction_role_count(data.level_id, data.faction, role)
end

local function _select_service_role(data, taken)
    local best_role, best_count
    for i = 1, #SERVICE_ROLES do
        local role = SERVICE_ROLES[i]
        local count = _get_eligible_role_count(data, role, taken)
        if count and (not best_count or count < best_count) then
            best_role, best_count = role, count
        end
    end
    return best_role
end

-- Roll one outpost's plan once at conquest: services (1..slider, clamped by the per-map budget,
-- distinct least-represented roles) and a guard count. Data only; the scan writes the respawn rows.
-- @cost O(rolled roles * conquered) meters, at conquest only
_build_plan = function(entry, smart_id)
    entry.services = {}
    local smart = xobject.get_se(smart_id)
    local suitable = smart and (smart.max_population or 0) >= SERVICE_MIN_MAX_POP
        and (xsmart.has_campfire(smart) or xsmart.has_surge_shelter(smart))
    local want = (suitable and cfg.mutator_area_conquest_grow_services)
        and math_random(1, cfg.mutator_area_conquest_services_per_smart) or 0
    local budget = cfg.mutator_area_conquest_services_max_per_level - _get_service_count(entry.level_id)
    if want > budget then want = budget end
    for _ = 1, want do
        local role = _select_service_role(entry, entry.services)
        if not role then break end
        entry.services[role] = true
    end
    local g_max = cfg.mutator_area_conquest_guards_per_smart
    entry.guards = (g_max > 0) and math_random(1, g_max) or 0
    if ap_core_debug.is_enabled() then
        local roles = {}
        for role in pairs(entry.services) do roles[#roles + 1] = role end
        ap_core_debug.debug("[MUTATOR.SMART] plan: smart=%d faction=%s services=%s guards=%d",
            smart_id, entry.faction, (#roles > 0) and table.concat(roles, ",") or "-", entry.guards)
        if smart then
            ap_core_debug.debug("[MUTATOR.SMART] suitability: smart=%d name=%s max_pop=%d campfire=%s surge=%s suitable=%s want=%d",
                smart_id, smart:name(), smart.max_population or 0,
                tostring(xsmart.has_campfire(smart)), tostring(xsmart.has_surge_shelter(smart)),
                tostring(suitable and true or false), want)
        end
    end
end

-- Pin one outpost squad at its smart via scripted_target and ledger it.
-- The pin persists in the squad packet (sim_squad_scripted.script:105-106,940-943), ending only on decay or death.
-- @cost O(1) | 2 luabind heavy (smart:name + squad:section_name string allocs) on pin
local function _register_hold(squad, smart_id, role, now)
    local smart = xobject.get_se(smart_id)
    if not smart then return end
    xsquad.set_target_smart(squad, smart)
    _held_squads[squad.id] = { smart_id = smart_id, smart_name = smart:name(),
        section = squad:section_name(), role = role, held_at = now }
    ap_core_debug.debug("[MUTATOR.SMART] hold: smart=%d role=%s squad=%d", smart_id, role, squad.id)
end

-- Give a newborn service its sidearm, offline-capable (xinventory.create_item takes its server-entity branch beyond respawn_radius).
-- Every fresh spawn passes here, so no service is seen unarmed.
-- @cost O(members) | 2 xinventory.create_item per member, spawn-time only
local function _create_service_sidearm(squad)
    for member_id in xsquad.iterate_member_ids(squad) do
        xinventory.create_item(SERVICE_WEAPON, member_id, { cond = 1 })
        xinventory.create_item(SERVICE_AMMO, member_id, { ammo = SERVICE_AMMO_ROUNDS })
        ap_core_debug.debug("[MUTATOR.SMART] service_armed: npc=%d weapon=%s", member_id, SERVICE_WEAPON)
    end
end

-- Classify a fresh spawn and pin it when it belongs to an outpost plan.
-- Guard-row spawns become pinned guards, service-key spawns become that armed role; conquest-row spawns roam free.
-- @cost O(1) | +_create_service_sidearm on a service spawn
local function _try_pin_spawn(squad, smart_id, prop, now)
    if not _state.conquest[smart_id] then return end
    if prop == GUARD_KEY then
        _register_hold(squad, smart_id, "guard", now)
        return
    end
    local role = _parse_role(prop)
    if not role then return end
    _register_hold(squad, smart_id, role, now)
    _create_service_sidearm(squad)
end

-- Re-write the outpost plan's respawn rows on a held conquer smart, one per service role plus a guard row.
-- The load path, idempotent between loads; called after mut.apply has set smart.faction.
-- @cost O(services) | 0 luabind (pure Lua table writes)
local function _apply_service_entries(smart, data)
    if not data.services then return end
    for role in pairs(data.services) do
        xsmart_spawn.set_exclusive_spawn_section(smart, _get_service_key(role), _get_service_section(data.faction, role), 1)
    end
    if (data.guards or 0) > 0 then
        local pool = xsmart_spawn.get_tiered_faction_squads(smart, data.faction)
        if pool then
            xsmart_spawn.set_exclusive_spawn_section(smart, GUARD_KEY, pool, data.guards)
        end
    end
end

-- Remove a service squad from the world, clearing each member's PDA spot first (remove_level_spot).
-- A decay removal skips the death path vanilla clears the spot on, else the icon lingers.
-- @cost O(members) | remove_level_spot per member + remove_squad
local function _remove_service_squad(squad)
    for member_id in xsquad.iterate_member_ids(squad) do
        stalker_generic.remove_level_spot(member_id)
    end
    xsquad.remove_squad(squad)
end

-- Resolve a held entry's squad with identity intact: the id must carry the pinned section.
-- Freed server ids are recycled (xrServer.cpp:873), so a mismatch is stale, prune it.
-- @cost O(1) | 1 luabind (xobject.get_se) + clsid + 1 heavy (section_name) on a live squad
local function _resolve_held(squad_id, entry)
    local squad = xobject.get_se(squad_id)
    if not squad or not xsquad.is_squad(squad) then return nil end
    if entry.section and squad:section_name() ~= entry.section then return nil end
    return squad
end

-- Register one stationed squad when it is an untracked outpost service (role = trailing word of ap_service_<faction>_<role>).
-- Adopts a service that missed its spawn pin.
-- @cost O(1) | section_name (heavy) only on an untracked stationed squad
local function _register_stationed_squad(squad, smart_id, now)
    if _held_squads[squad.id] then return end
    local sec = squad.section_name and squad:section_name()
    if not sec or sec:sub(1, #SERVICE_KEY_PREFIX) ~= SERVICE_KEY_PREFIX then return end
    local role = sec:match("_(%a+)$")
    if role and _ROLE_SET[role] then _register_hold(squad, smart_id, role, now) end
end

-- Walk one conquest smart's stationed squads, adopting untracked services.
-- @cost O(min(stationed, 5)) | one iterate_stationed_squads walk
local function _register_smart_stationed_services(smart_id, now)
    for squad in xsmart.iterate_stationed_squads(smart_id) do
        _register_stationed_squad(squad, smart_id, now)
    end
end

-- Discovery sweep: adopt any untracked service squad stationed at a conquest smart (covers a spawn pin missed at load).
-- Rides the 60s pass and the load reconcile, not the invariant pass.
-- @cost O(conquest smarts) | one iterate_stationed_squads walk per smart
local function _register_stationed_services(now)
    for smart_id in pairs(_state.conquest) do
        _register_smart_stationed_services(smart_id, now)
    end
end

-- One held outpost squad per scan pass: resolve identity, then reassert the pin.
-- A dead or recycled id prunes the ledger row only, never the squad; returns false when the caller drops the entry.
-- @cost O(1) | _resolve_held + set_target
local function _update_service(squad_id, entry)
    local squad = _resolve_held(squad_id, entry)
    if not squad or not _state.conquest[entry.smart_id] then
        ap_core_debug.debug("[MUTATOR.SMART] hold_drop: smart=%d role=%s squad=%d %s",
            entry.smart_id, entry.role, squad_id, squad and "unledgered" or "gone")
        return false
    end
    local dbg = ap_core_debug.is_enabled()
    local prev_target = dbg and squad.scripted_target
    if xsquad.set_target(squad, entry.smart_name) and dbg then
        local cur = xobject.get_se(squad.smart_id)
        ap_core_debug.debug("[MUTATOR.SMART] pin_lost: smart=%d(%s) role=%s squad=%d prev_target=%s cur_smart=%s base=%s",
            entry.smart_id, entry.smart_name, entry.role, squad_id,
            tostring(prev_target), tostring(squad.smart_id), tostring(cur and xsmart.is_base(cur)))
    end
    return true
end

-- Scan step: keep each held squad pinned, prune stale ledger entries.
-- Drops are collected then nil'd after the walk (pairs-safe).
-- @cost O(n) held squads | 1-2 luabind each
local function _update_holds()
    local drop = 0
    for squad_id, entry in pairs(_held_squads) do
        if not _update_service(squad_id, entry) then
            drop = drop + 1
            _hold_drop_collector[drop] = squad_id
        end
    end
    for i = 1, drop do
        _held_squads[_hold_drop_collector[i]] = nil
        _hold_drop_collector[i] = nil
    end
end

-- Show the engine PDA role icon on one online service (stalker_generic.script:98-126), gated like vanilla on goodwill > -1000.
-- Re-asserted every scan since a scheme reset removes the spot.
-- @cost O(1) | 1 luabind (general_goodwill) + 2 heavy (map spot remove + add) per service per scan
local function _show_service_icon(go, member_id, role)
    local spot = SERVICE_ICON[role]
    if not spot or not db.actor then return end
    local goodwill = xcreature.get_actor_goodwill(go)
    if not goodwill then return end
    if goodwill <= -1000 then
        ap_core_debug.debug("[MUTATOR.SMART] service_icon_skip: npc=%d role=%s goodwill=%d (hostile)", member_id, role, goodwill)
        return
    end
    local add_ok = xpda.add_entity_marker(member_id, { marker_type = spot.icon, label = spot.hint })
    ap_core_debug.debug("[MUTATOR.SMART] service_icon: npc=%d role=%s goodwill=%d marker=%s add_ok=%s",
        member_id, role, goodwill, spot.icon, tostring(add_ok))
end

-- Init the trade config on one online service member (trade_init only); stocking is lazy on-use.
-- create_trader is idempotent; entry.stocked marks the profile inited this session.
-- @cost O(1) | create_trader (trade_init)
local function _init_member_trade(go, member_id, cfg_path, entry)
    if not xcreature.create_trader(go, cfg_path) then return end
    entry.stocked = true
    local st = db.storage[member_id]
    ap_core_debug.debug("[MUTATOR.SMART] service_init: smart=%d role=%s npc=%d job=%s",
        entry.smart_id, entry.role, member_id, tostring(st and st.active_section))
end

-- Initialise the trade config on an uninitialised online member, or re-init it when the config drifted off the role (cfg_ltx compare).
-- The shelf restocks lazily on-use; split from _try_stock for the nesting cap.
local function _apply_trade_config(go, member_id, cfg_path, entry)
    if entry.stocked then
        if trade_manager.get_trade_profile(member_id, "cfg_ltx") == cfg_path then return end
        ap_core_debug.debug("[MUTATOR.SMART] service_cfg_drift: smart=%d role=%s npc=%d",
            entry.smart_id, entry.role, member_id)
    end
    _init_member_trade(go, member_id, cfg_path, entry)
end

-- Stock one held service once its member is online and keep it stocked.
-- A job reassignment reverts the trade config to generic (xr_logic.script:113), so the cfg_ltx compare re-inits it each scan.
-- @cost O(members) | 1 luabind (xobject.get_go) per member until the online one + 1 profile read
local function _try_stock(squad_id, entry)
    local squad = _resolve_held(squad_id, entry)
    if not squad then return end
    local data = _state.conquest[entry.smart_id]
    if not data then return end
    local cfg_path = _get_role_cfg_path(data.faction, entry.role)
    if not cfg_path then return end
    for member_id in xsquad.iterate_member_ids(squad) do
        local go = xobject.get_go(member_id)
        if go then
            _apply_trade_config(go, member_id, cfg_path, entry)
            _show_service_icon(go, member_id, entry.role)
            return
        end
    end
end

-- Live talk/trade/meet snapshot string for one online service member ("online=false" when offline).
local function _format_service_diag(member_id)
    local go = member_id and xobject.get_go(member_id)
    if not go then return "online=false" end
    local st = db.storage[member_id]
    local mm = st and st.meet and st.meet.meet_manager
    return string_format("online=true name=%s job=%s talk=%s use=%s trade_en=%s director=%s rel=%s",
        tostring(go:name()), tostring(st and st.active_section),
        tostring(go:is_talk_enabled()), tostring(mm and mm.use), tostring(mm and mm.trade_enable),
        tostring(mm and mm.npc_is_camp_director), tostring(xcreature.get_actor_relation(go)))
end

local function _log_service_entry(squad_id, entry)
    local member_id
    local squad = _resolve_held(squad_id, entry)
    if squad then
        for id in xsquad.iterate_member_ids(squad) do member_id = id break end
    end
    local cur = squad and xobject.get_se(squad.smart_id)
    ap_core_world_trace.debug("[MUTATOR.SMART] service: smart=%d(%s) role=%s squad=%d stocked=%s pin=%s cur_smart=%s base=%s %s",
        entry.smart_id, entry.smart_name, entry.role, squad_id,
        tostring(entry.stocked or false),
        tostring(squad and squad.scripted_target),
        tostring(squad and squad.smart_id),
        tostring(cur and xsmart.is_base(cur)),
        _format_service_diag(member_id))
end

local function _log_services()
    for squad_id, entry in pairs(_held_squads) do
        _log_service_entry(squad_id, entry)
    end
end

-- Scan step: initialise the trade config on any held online service not yet initialised, and re-init one whose config drifted.
-- The shelf stocks lazily on-use, not here (guards skipped).
-- @cost O(n) held squads | _resolve_held + member resolve + 1 profile read per service
local function _init_service_trades()
    for squad_id, entry in pairs(_held_squads) do
        if entry.role ~= "guard" then
            _try_stock(squad_id, entry)
        end
    end
end

-- Release an unmade service's shop stock, keeping equipped and untouchable items (the sidearm stays).
-- Collect-then-release, each guarded on a live server object (the straggler idiom).
-- @cost O(inventory) | get_category per item + alife_release per shop item
local function _release_stock(npc)
    local opts = xinventory.get_category_opts(npc)
    local drop = {}
    xinventory.iterate_inventory(npc:id(), function(_, item)
        local cat = xinventory.get_category(item, opts)
        if cat ~= "equipped" and cat ~= "untouchable" then drop[#drop + 1] = item end
    end)
    for i = 1, #drop do
        local se_item = xobject.get_se(drop[i]:id())
        xobject.release(se_item)
    end
end

-- Demote one online service in place when decay reaches it in view: re-init trade to generic, release stock, remove the PDA icon.
-- The pin is left alone so he stays an ordinary armed resident.
-- @cost O(members) | create_trader + _release_stock + remove_level_spot per member
local function _reset_service(squad, entry)
    for member_id in xsquad.iterate_member_ids(squad) do
        local go = xobject.get_go(member_id)
        if go then
            xcreature.create_trader(go, GENERIC_TRADE)
            _release_stock(go)
        end
        stalker_generic.remove_level_spot(member_id)
    end
    ap_core_debug.debug("[MUTATOR.SMART] service_unmade: smart=%d role=%s squad=%d",
        entry.smart_id, entry.role, squad.id)
end

-- Clear the plan's respawn rows on a decayed smart (service keys plus the guard row).
-- The per-row engine counters are never zeroed, so a leftover keeps its count until it dies.
local function _clear_plan_rows(smart, data)
    if not smart then return end
    for role in pairs(data.services or {}) do
        xsmart_spawn.clear_shared_spawn(smart, _get_service_key(role))
    end
    xsmart_spawn.clear_shared_spawn(smart, GUARD_KEY)
end

-- Dissolve one held service at decay: online -> _reset_service demotes in place, offline -> _remove_service_squad deletes it unseen.
-- The online read is the decision, not a filter.
local function _destroy_service(squad_id, entry)
    local squad = _resolve_held(squad_id, entry)
    if not squad then return end
    if squad.online then _reset_service(squad, entry)
    else _remove_service_squad(squad) end
end

-- Debug-only: log a held squad's last-known pin state at the instant decay drops its ledger entry.
-- The handoff point past which a cleared pin is never restored.
-- @cost noop when debug off (single enabled() gate); on decay only
local function _log_hold_release(smart_id, entry, squad_id)
    if not ap_core_debug.is_enabled() then return end
    local sq = xobject.get_se(squad_id)
    local cur = sq and xobject.get_se(sq.smart_id)
    ap_core_debug.debug("[MUTATOR.SMART] hold_release: smart=%d role=%s squad=%d pin=%s cur_smart=%s base=%s (no reassert after this)",
        smart_id, entry.role, squad_id,
        tostring(sq and sq.scripted_target), tostring(sq and sq.smart_id),
        tostring(cur and xsmart.is_base(cur)))
end

-- Decay teardown: clear our rows, dissolve services (_destroy_service).
-- Guards stay as ordinary residents, only their ledger entries drop.
-- @cost O(n) held squads | unmake or remove per service at this smart
local function _release_smart_holds(smart_id, smart, data)
    _clear_plan_rows(smart, data)
    local drop = 0
    for squad_id, entry in pairs(_held_squads) do
        if entry.smart_id == smart_id then
            if entry.role ~= "guard" then _destroy_service(squad_id, entry) end
            _log_hold_release(smart_id, entry, squad_id)
            drop = drop + 1
            _hold_drop_collector[drop] = squad_id
        end
    end
    for i = 1, drop do
        _held_squads[_hold_drop_collector[i]] = nil
        _hold_drop_collector[i] = nil
    end
end

-- Clear the respawn entry for one decayed record and log it.
-- Conquest also tears down its outpost: release the held guards / services and clear their respawn entries.
local function _clear_entry(mut, smart_id, data, ts, now)
    local smart = xobject.get_se(smart_id)
    if smart then
        mut.clear(smart, mut.key)
    end
    if mut.grows_services then _release_smart_holds(smart_id, smart, data) end
    ap_core_debug.debug("[MUTATOR.SMART] %s_decay: smart=%d %s=%s age=%dh",
        mut.name, smart_id, mut.id_word, data.faction, math_floor((now - ts) / 3600))
end

-- Re-apply one live entry (mut.apply plus the plan rows): the load path, since on_register rebuilds respawn_params from LTX each load.
-- Respawn timing is never touched.
local function _apply_entry(mut, smart_id, data)
    local smart = xobject.get_se(smart_id)
    if not smart then return end
    mut.apply(smart, mut.key, data.faction, cfg[mut.num_cfg])
    if mut.grows_services then _apply_service_entries(smart, data) end
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("[MUTATOR.SMART] %s: smart=%d %s=%s squads=%d (held)",
            mut.name, smart_id, mut.id_word, data.faction, _get_smart_squad_count(smart_id))
    end
end

-- Re-apply live entries and decay expired ones for one mutation type.
-- @cost O(n) entries of this type | 1 luabind (xobject.get_se) per entry
local function _update_entries(mut, now)
    if not cfg or not cfg[mut.mutate_cfg] then return end
    local tbl = _state[mut.name]
    local decay_sec = cfg[mut.decay_cfg] * 3600
    local count = 0
    for smart_id, data in pairs(tbl) do
        local ts = data[mut.ts_field]
        if decay_sec > 0 and ts and (now - ts) > decay_sec then
            _clear_entry(mut, smart_id, data, ts, now)
            count = count + 1
            _decay_collector[count] = smart_id
        else
            _apply_entry(mut, smart_id, data)
        end
    end
    for i = 1, count do
        tbl[_decay_collector[i]] = nil
        _decay_collector[i] = nil
    end
end

-- True when any exclusive respawn row has fewer live spawns than its quota.
-- row.num is a parsed condlist, resolved the way the engine's gate does (smart_terrain.script:1669), not a bare number.
-- @cost O(rows) | pure Lua (condlist eval, no bridge)
local function _is_below_quota(smart)
    local rp, spawned = smart.respawn_params, smart.already_spawned
    if not rp or not spawned then return false end
    for key, row in pairs(rp) do
        local target = tonumber(xr_logic.pick_section_from_condlist(db.actor, smart, row.num) or 0) or 0
        local have = spawned[key] and spawned[key].num or 0
        if have < target then return true end
    end
    return false
end

-- Pace one held smart's refill, accelerate-only: below quota and our interval elapsed nils last_respawn_update so the next try_respawn fires.
-- Still radius-gated; never throttles a fast world.
-- @cost O(rows) pure Lua | 0 luabind (last_respawn_update is a Lua field)
local function _update_smart_pacing(mut, smart_id, interval_sec, now)
    local smart = xobject.get_se(smart_id)
    if not smart then return end
    if not _is_below_quota(smart) then
        _respawn_stamp[smart_id] = nil
        return
    end
    local stamp = _respawn_stamp[smart_id]
    if not stamp then _respawn_stamp[smart_id] = now; return end
    local age = now - stamp
    if age >= interval_sec then
        smart.last_respawn_update = nil
        ap_core_debug.debug("[MUTATOR.SMART] respawn_due: smart=%d %s waited=%ds", smart_id, mut.name, age)
    else
        ap_core_debug.debug("[MUTATOR.SMART] respawn_wait: smart=%d %s age=%ds/%ds", smart_id, mut.name, age, interval_sec)
    end
end

-- Pace one mutation type's held smarts on cfg[mut.respawn_idle_cfg] game-minutes.
-- A zero/absent interval opts the mutation out (its smarts keep the world's own pacing).
-- @cost O(held smarts of this type) | _update_smart_pacing each
local function _update_mutation_pacing(mut, now)
    local minutes = mut.respawn_idle_cfg and cfg[mut.respawn_idle_cfg]
    if not minutes or minutes <= 0 then return end
    local interval_sec = minutes * 60
    for smart_id in pairs(_state[mut.name]) do
        _update_smart_pacing(mut, smart_id, interval_sec, now)
    end
end

-- Pace every mutation type's held smarts.
local function _update_pacing(now)
    for _, mut in pairs(MUTATIONS) do
        _update_mutation_pacing(mut, now)
    end
end

-- 60s re-apply + decay pass over every mutation type; timed when debug is on.
-- ResetTimeEvent first, so an error mid-body cannot leave the event refiring every frame.
local function _update_mutations()
    ResetTimeEvent(TIMER_EV, SCAN_ID, SCAN_INTERVAL_SEC)
    local now = xtime.get_game_sec()
    local prof = xprofiler.new_if(ap_core_debug.is_enabled())
    prof:reset():start()
    for _, mut in pairs(MUTATIONS) do _update_entries(mut, now) end
    prof:stop(); local update_ms = prof:get_ms()
    prof:reset():start()
    _register_stationed_services(now)
    prof:stop(); local adopt_ms = prof:get_ms()
    prof:reset():start()
    _update_holds()
    prof:stop(); local holds_ms = prof:get_ms()
    prof:reset():start()
    _init_service_trades()
    prof:stop(); local stock_ms = prof:get_ms()
    prof:reset():start()
    _update_pacing(now)
    prof:stop(); local pace_ms = prof:get_ms()
    if ap_core_world_trace.is_enabled() then _log_services() end
    if ap_core_debug.is_enabled() then
        ap_core_debug.debug("[MUTATOR.SMART] scan: update=%.2f adopt=%.2f holds=%.2f stock=%.2f pace=%.2f ms",
            update_ms, adopt_ms, holds_ms, stock_ms, pace_ms)
    end
end

-- Re-assert a mutated smart's owner faction the instant before the engine's respawn gate reads it (on_try_respawn -> smart_terrain.script:1667).
-- Fixes the online-empty revert; timing untouched.
-- @cost O(1) | up to 3 hash reads per smart update, pure Lua, 0 luabind
local function _on_try_respawn(smart)
    if not smart then return end
    local id = smart.id
    local entry = _state.conquest[id] or _state.swarm[id] or _state.infest[id]
    if entry then smart.faction = entry.faction end
end

local function _on_save_state(m_data)
    local out = {}
    for _, mut in pairs(MUTATIONS) do
        out[mut.save_key] = _state[mut.name]
    end
    m_data.ap_ext_smart_mutator = out
    m_data.ap_ext_smart_mutator_holds = _held_squads
end

local function _on_load_state(m_data)
    local saved = m_data.ap_ext_smart_mutator
    if type(saved) ~= "table" then saved = {} end
    for _, mut in pairs(MUTATIONS) do
        _state[mut.name] = {}
        local entries = saved[mut.save_key]
        _pending[mut.name] = (type(entries) == "table") and entries or {}
    end
    local holds = m_data.ap_ext_smart_mutator_holds
    _held_pending = (type(holds) == "table") and holds or {}
end

-- Rebuild one live entry from its saved form: timestamp fallback, plan fields for growers.
-- A saved numeric guards field marks a plan-era entry; its absence rolls a fresh plan under current sliders.
local function _load_entry(mut, data, now, smart_id)
    local entry = { faction = data.faction, level_id = data.level_id, [mut.ts_field] = data[mut.ts_field] or now }
    if mut.grows_services then
        if type(data.guards) == "number" then
            entry.services = (type(data.services) == "table") and data.services or {}
            entry.guards = data.guards
        else
            _build_plan(entry, smart_id)
        end
        if not cfg.mutator_area_conquest_grow_services then entry.services = {} end
    end
    return entry
end

-- Restore saved entries into live state on load, dropping malformed ones.
-- Infest re-checks its per-level cap; conquest/swarm gate only new takes, so an over-cap save decays.
local function _load_pending(mut, now)
    local pending = _pending[mut.name]
    if not pending then return end
    if not cfg or not cfg[mut.mutate_cfg] then
        _pending[mut.name] = nil
        ap_core_debug.info("[MUTATOR.SMART] on_game_load: %s disabled, skipped restore", mut.name)
        return
    end
    local tbl = _state[mut.name]
    local restored, skipped = 0, 0
    for smart_id, data in pairs(pending) do
        if type(data) == "table" and data.faction and data.level_id then
            if mut.cap and not mut.cap(data.level_id) then
                skipped = skipped + 1
            else
                tbl[smart_id] = _load_entry(mut, data, now, smart_id)
                restored = restored + 1
            end
        end
    end
    _pending[mut.name] = nil
    if mut.cap then
        ap_core_debug.debug("[MUTATOR.SMART] on_game_load: %s restored=%d skipped=%d", mut.name, restored, skipped)
    else
        ap_core_debug.debug("[MUTATOR.SMART] on_game_load: %s restored=%d", mut.name, restored)
    end
end

-- Restore the pinned-outpost ledger; scripted_target persists natively, the scan reasserts and prunes.
-- Trader feature off: each non-guard entry is despawned here (the clean teardown), guards stay.
local function _load_holds()
    _held_squads = {}
    if type(_held_pending) ~= "table" then _held_pending = nil; return end
    local purge_services = not cfg.mutator_area_conquest_grow_services
    local restored, purged = 0, 0
    for squad_id, entry in pairs(_held_pending) do
        if type(entry) == "table" and entry.smart_id and entry.role then
            if purge_services and entry.role ~= "guard" then
                local squad = _resolve_held(squad_id, entry)
                if squad then _remove_service_squad(squad) end
                purged = purged + 1
            else
                entry.stocked = nil
                _held_squads[squad_id] = entry
                restored = restored + 1
            end
        end
    end
    _held_pending = nil
    ap_core_debug.debug("[MUTATOR.SMART] on_game_load: holds restored=%d purged=%d", restored, purged)
end

local function _on_game_load()
    local now = xtime.get_game_sec()
    for _, mut in pairs(MUTATIONS) do _load_pending(mut, now) end
    _load_holds()
    _update_mutations()
end

-- Deferred spawn handler: respawn_point_prop_section is set after create_squad returns (smart_terrain.script:1720-1721), so reading it needs a tick.
-- Pins outpost squads by their key.
-- @cost 1-2 luabind (xobject.get_se + section_name) per deferred spawn
local function _on_spawn_deferred(squad_id, smart_id)
    local squad = xobject.get_se(squad_id)
    if not squad then return true end
    local prop = squad.respawn_point_prop_section
    _try_pin_spawn(squad, smart_id, prop, xtime.get_game_sec())
    if not ap_core_debug.is_enabled() then return true end
    local mut = _mut_by_key[prop]
    if not mut then return true end
    local data = _state[mut.name][smart_id]
    local faction = data and data.faction or "?"
    local section = squad.section_name and squad:section_name() or "?"
    ap_core_debug.debug("[MUTATOR.SMART] %s_spawn: smart=%d %s=%s section=%s squad=%d",
        mut.name, smart_id, mut.id_word, faction, section, squad_id)
    return true
end

-- Correct one outpost service to a rank-and-file rank on its server object.
-- The online character inherits it and it never re-rolls (the engine rolls only on NO_RANK, xrServer_..._Monsters.cpp:472).
-- @cost O(1) | 1 luabind (set_rank)
local function _set_service_rank(se_obj)
    if not (se_obj and se_obj.set_rank) then return end
    local trace = ap_core_debug.is_enabled()
    local before = trace and se_obj:rank()
    se_obj:set_rank(SERVICE_RANK)
    if trace then
        ap_core_debug.debug("[MUTATOR.SMART] service_rank: npc=%d %s -> %s",
            se_obj.id, tostring(before), tostring(se_obj:rank()))
    end
end

-- squad_on_npc_creation (sim_board.script:149), before try_respawn writes respawn_point_*.
-- Corrects a service member's rank synchronously; defers the spawn pin only for a conquered smart or debug trace.
-- @cost O(1) | 1 conquest hash read; 1 CreateTimeEvent only on an outpost/traced spawn
local function _on_npc_creation(squad, se_obj, spawn_smart)
    if not spawn_smart then return end
    local sec = squad and squad.section_name and squad:section_name()
    if sec and sec:sub(1, #SERVICE_KEY_PREFIX) == SERVICE_KEY_PREFIX then _set_service_rank(se_obj) end
    local smart_id = spawn_smart.id
    if _state.conquest[smart_id] or _state.swarm[smart_id] or _state.infest[smart_id] then
        _respawn_stamp[smart_id] = xtime.get_game_sec()
    end
    if not _state.conquest[smart_id] and not ap_core_debug.is_enabled() then return end
    CreateTimeEvent("ap_spawn_deferred", squad.id, 0, _on_spawn_deferred, squad.id, spawn_smart.id)
end

-- Outpost stock policy: per-role shelf caps plus a money bankroll, from ap_outpost_stock_policy.ltx.
local STOCK_POLICY_PATH = "alifeplus\\ap_outpost_stock_policy.ltx"
local STOCK_POLICY_PREFIX = "ap_outpost_stock_"
local STOCK_FILTER_EV = "ap_outpost_stock_filter"
local _STOCK_SPECIALS = { money = true }
local _stock_policy
local _stock_money

local function _load_stock_policy()
    local sections = {}
    for i = 1, #SERVICE_ROLES do sections[i] = STOCK_POLICY_PREFIX .. SERVICE_ROLES[i] end
    local loaded = xinventory.load_policy(STOCK_POLICY_PATH, sections, _STOCK_SPECIALS)
    local out, money, count, money_count = nil, nil, 0, 0
    for i = 1, #SERVICE_ROLES do
        local role = SERVICE_ROLES[i]
        local block = loaded and loaded[STOCK_POLICY_PREFIX .. role]
        local rules = block and block.rules
        if rules and next(rules) then
            out = out or {}
            out[role] = rules
            count = count + 1
        end
        local bankroll = block and block.specials.money
        if bankroll and bankroll > 0 then
            money = money or {}
            money[role] = bankroll
            money_count = money_count + 1
        end
    end
    _stock_policy = out
    _stock_money = money
    if count < #SERVICE_ROLES then
        ap_core_debug.info("[MUTATOR.SMART] stock policy %s: %d/%d role blocks loaded, roles without one are unfiltered",
            STOCK_POLICY_PATH, count, #SERVICE_ROLES)
    end
    if money_count < #SERVICE_ROLES then
        ap_core_debug.info("[MUTATOR.SMART] stock policy %s: %d/%d money rows loaded, roles without one keep engine money",
            STOCK_POLICY_PATH, money_count, #SERVICE_ROLES)
    end
end

-- npc -> its _held_squads entry when it is an outpost service (not guard), else nil.
-- An empty ledger returns before the get_object_squad lookup, so with no outposts the wrapper costs one hash probe.
local function _get_service_entry(npc)
    if not next(_held_squads) then return nil end
    local squad = get_object_squad(npc)
    local entry = squad and _held_squads[squad.id]
    return (entry and entry.role ~= "guard") and entry or nil
end

-- npc -> true when it is an outpost service by section identity, ledgered or not: the permanent key for the task/hub-dialog gates.
-- An unmade leftover stays gated for life; guards never match.
-- @cost O(1) | get_object_squad + 1 heavy (section_name), dialog/task open only
local function _is_service_npc(npc)
    if not npc then return false end
    local squad = get_object_squad(npc)
    local sec = squad and squad.section_name and squad:section_name()
    return sec ~= nil and sec:sub(1, #SERVICE_KEY_PREFIX) == SERVICE_KEY_PREFIX
end

-- trade_manager keeps its CTime<->table converters file-local (trade_manager.script:9-23).
-- The stamp written here must be that exact saved shape, so both are mirrored verbatim.
local function _build_ctime_table(ct)
    local Y, M, D, h, m, s, ms = ct:get(0, 0, 0, 0, 0, 0, 0)
    return { Y = Y, M = M, D = D, h = h, m = m, s = s, ms = ms }
end

local function _parse_ctime(t)
    local ct = game.CTime()
    ct:set(t.Y, t.M, t.D, t.h, t.m, t.s, t.ms)
    return ct
end

-- Trader-only: when a restock is due and the below-hub clamp bites, stamp + stock the effective tier before the original update.
-- Returns true when it did, so the caller drops force_refresh.
local function _try_preempt_below_hub(npc, id, force_refresh)
    local tm = trade_manager.get_trade_profile(id)
    if not tm or not tm.cfg_ltx then return false end
    local now_ct = xtime.get_game_time()
    if not now_ct then return false end
    if not force_refresh and tm.resupply_time then
        local restock_time = game_difficulties.get_eco_factor("restock") or 24
        if now_ct:diffSec(_parse_ctime(tm.resupply_time)) < restock_time * 3600 then return false end
    end
    local config = trade_manager.get_trade_cfg(tm.cfg_ltx)
    if not config then return false end
    local supplies = config:r_string_ex("trader", "buy_supplies")
    if not supplies then return false end
    local condlist = xr_logic.parse_condlist(npc, "trader", "buy_supplies", supplies)
    supplies = condlist and xr_logic.pick_section_from_condlist(db.actor, npc, condlist)
    if supplies == nil or supplies == "" then return false end
    local picked = tonumber(string_match(supplies, "^supplies_(%d+)$"))
    if not picked then return false end
    local effective = picked - cfg.mutator_area_conquest_trader_supplies_penalty
    local cap = cfg.mutator_area_conquest_trader_supplies_tier
    if effective > cap then effective = cap end
    if effective < 1 then effective = 1 end
    if effective >= picked then return false end
    tm.resupply_time = _build_ctime_table(now_ct)
    npc:buy_supplies(config, "supplies_" .. effective)
    tm.current_buy_supplies = "supplies_" .. effective
    ap_core_debug.debug("[MUTATOR.SMART] supplies_below_hub: npc=%d hub=%d outpost=%d", id, picked, effective)
    return true
end

-- Map an engine item category to its outpost-stock policy key: ammo_* folds to ammo_rounds_per_type.
-- Every other category already matches the policy vocabulary.
local function _get_shelf_key(category)
    if string_sub(category, 1, 5) == "ammo_" then return "ammo_rounds_per_type" end
    return category
end

-- Category filter over a service's restocked shelf: release items past their rule's cap.
-- A category row is a shelf total, ammo is per-type, a section row caps that section (xinventory.get_policy_key).
-- @cost O(stock) | get_category + section per item, release per over-cap item
local function _filter_stock(npc, npc_id, role)
    local rules = _stock_policy and _stock_policy[role]
    if not rules then return end
    local opts = xinventory.get_category_opts(npc)
    local counted = {}
    local drop = {}
    local seen = 0
    xinventory.iterate_inventory(npc_id, function(_, item)
        seen = seen + 1
        local cat = xinventory.get_category(item, opts)
        if cat == "equipped" or cat == "untouchable" then return end
        local sec = item:section()
        local section_rule = rules[sec]
        local rule = section_rule or rules[_get_shelf_key(cat)]
        if not rule then return end
        local is_ammo = string_sub(cat, 1, 5) == "ammo_"
        local key = (is_ammo or section_rule) and sec or cat
        local unit = is_ammo and (item:ammo_get_count() or 0) or 1
        local total = (counted[key] or 0) + unit
        counted[key] = total
        if total > rule.max then drop[#drop + 1] = item end
    end)
    local removed = 0
    for i = 1, #drop do
        if xobject.get_se(drop[i]:id()) then
            xinventory.release_item(drop[i])
            removed = removed + 1
        end
    end
    ap_core_debug.debug("[MUTATOR.SMART] stock_filter: npc=%d role=%s seen=%d removed=%d", npc_id, role, seen, removed)
end

-- Deferred ~1s after restock: buy_supplies respawns the shelf and its items register over the next ticks, not the next frame.
-- A shorter defer walks a half-spawned inventory and removes nothing.
local function _filter_stock_deferred(npc_id, role)
    local npc = xobject.get_go(npc_id)
    if npc then _filter_stock(npc, npc_id, role) end
    return true
end

-- Reset the service's money to his role's policy bankroll on a detected restock, capping the cash a player can extract per cycle.
-- The delta rides give_money (GiveMoney); an absent row leaves it alone.
-- @cost O(1) | 2 luabind (money read + give_money on a delta)
local function _reset_bankroll(npc, id, role)
    local bankroll = _stock_money and _stock_money[role]
    if not bankroll then return end
    local delta = bankroll - npc:money()
    if delta ~= 0 then npc:give_money(delta) end
    ap_core_debug.debug("[MUTATOR.SMART] bankroll: npc=%d role=%s money=%d", id, role, bankroll)
end

-- trade_manager.update wrapper for outpost services: below-hub preempt, bankroll reset, stock filter.
local _org_update_trade
local function _update_trade(npc, force_refresh)
    local entry = npc and _get_service_entry(npc)
    if not entry or not cfg then return _org_update_trade(npc, force_refresh) end
    local id = npc:id()
    local stamp = trade_manager.get_trade_profile(id, "resupply_time")
    if entry.role == "trader" and _try_preempt_below_hub(npc, id, force_refresh) then
        force_refresh = nil
    end
    _org_update_trade(npc, force_refresh)
    if trade_manager.get_trade_profile(id, "resupply_time") == stamp then return end
    _reset_bankroll(npc, id, entry.role)
    if _stock_policy and _stock_policy[entry.role] then
        CreateTimeEvent(STOCK_FILTER_EV, id, 1, _filter_stock_deferred, id, entry.role)
    end
end

-- trader_autoinject.get_trader_type wrapper (script:85-111); a ledgered service answers its role.
local _org_get_trader_type
local _trader_type_by_role
local function _get_trader_type(npc)
    local entry = npc and _get_service_entry(npc)
    local trader_type = entry and _trader_type_by_role[entry.role]
    if trader_type then return trader_type end
    return _org_get_trader_type(npc)
end

-- Random-task gate: service profiles hand out the Warfare task pool, uncompletable without Warfare.
local _org_build_available_tasks
local _hub_gated = {}

-- Pool side: the one seam the dialog and every PDA taskboard share, keyed on section identity.
-- An unmade leftover stays gated; runs the original then empties its result, keeping vanilla bookkeeping.
-- @cost O(1) + 1 heavy (squad section_name) on task-list generation only
local function _build_available_tasks(npc, is_sim)
    if not _is_service_npc(npc) then return _org_build_available_tasks(npc, is_sim) end
    _org_build_available_tasks(npc, is_sim)
    local npc_id = npc:id()
    local pool = axr_task_manager.available_tasks[npc_id]
    if pool then empty_table(pool) end
    ap_core_debug.debug("[MUTATOR.SMART] task_gate: npc=%d", npc_id)
end

-- Dialog side: wrap a hub-dialog <precondition> to return false for a service, closing task/broker/documents/route/pda topics.
-- Preconditions resolve by name (PhraseScript.cpp:185-218).
-- @cost O(1) | 1 luabind (who_is_npc) + the _get_service_entry probe, on dialog open only
local function _create_hub_gate(org)
    return function(first_speaker, second_speaker)
        local npc = first_speaker and second_speaker
            and dialogs.who_is_npc(first_speaker, second_speaker)
        if npc and _is_service_npc(npc) then return false end
        return org(first_speaker, second_speaker)
    end
end

-- Wrap one hub predicate in place, once, with the same probe as the trade_manager patch.
-- The type check guards a harness without vanilla scripts and triggers the in-game auto-load of the module.
local function _register_hub_gate(module, fn_name)
    if _hub_gated[fn_name] then return end
    if type(module) ~= "table" or type(module[fn_name]) ~= "function" then return end
    _hub_gated[fn_name] = true
    module[fn_name] = _create_hub_gate(module[fn_name])
end

-- keep_item's release idiom (death_manager.script:403), reused per item on a nulled corpse.
local function _release_item(_, item)
    local se_item = item and xobject.get_se(item:id())
    xobject.release(se_item)
end

-- Null a dead service NPC's loot; vanilla has no concept of trade stock.
-- Seam squad_on_npc_death (sim_squad_scripted.script:493) hands the squad before remove_npc strips its group_id.
-- @cost O(inventory) on a held service NPC's death only | xobject.get_go + alife_release per item
local function _on_squad_npc_death(squad, se_npc, _)
    if not squad or not se_npc then return end
    local entry = _held_squads[squad.id]
    if not entry or entry.role == "guard" then return end
    local victim = xobject.get_go(se_npc.id)
    if not victim then
        ap_core_debug.debug("[MUTATOR.SMART] service_loot_null: smart=%d role=%s npc=%d offline (skipped)",
            entry.smart_id, entry.role, se_npc.id)
        return
    end
    if ap_core_world_trace.is_enabled() then xinventory.log_inventory(victim, "service", ap_core_world_trace.debug) end
    xinventory.iterate_inventory(victim:id(), _release_item)
    ap_core_debug.debug("[MUTATOR.SMART] service_loot_null: smart=%d role=%s npc=%d",
        entry.smart_id, entry.role, se_npc.id)
end

-- Restore the missing fallback in xr_logic.get_customdata_or_ini_file for a saved "*" generated-ini name.
-- db.dynamic_ltx (xr_logic.script:1234-1236) has no fallback and would be an engine fatal; warn + default.
local function _resolve_logic_ini(original, npc, filename)
    local ini, name = original(npc, filename)
    if ini then return ini, name end
    ap_core_debug.warn("[MUTATOR.SMART] unresolved logic ini '%s' on npc=%s, loading empty logic",
        tostring(filename), npc:name())
    return ini_file("default_custom_data.ltx"), "default_custom_data.ltx"
end

function on_game_start()
    xevent.register_hook("xr_logic", "get_customdata_or_ini_file", _resolve_logic_ini)
    for _, mut in pairs(MUTATIONS) do
        _state[mut.name] = {}
        _pending[mut.name] = nil
    end
    _held_squads = {}
    _held_pending = nil
    _respawn_stamp = {}
    RegisterScriptCallback(CALLBACK.SAVE_STATE, _on_save_state)
    RegisterScriptCallback(CALLBACK.LOAD_STATE, _on_load_state)
    RegisterScriptCallback(CALLBACK.ON_GAME_LOAD, _on_game_load)
    RegisterScriptCallback(CALLBACK.SQUAD_ON_NPC_CREATION, _on_npc_creation)
    RegisterScriptCallback(CALLBACK.SQUAD_ON_NPC_DEATH, _on_squad_npc_death)
    RegisterScriptCallback(CALLBACK.ON_TRY_RESPAWN, _on_try_respawn)
    if not _org_update_trade and type(trade_manager) == "table" and type(trade_manager.update) == "function" then
        _org_update_trade = trade_manager.update
        trade_manager.update = _update_trade
    end
    if not _org_build_available_tasks and type(axr_task_manager) == "table"
        and type(axr_task_manager.generate_available_tasks) == "function" then
        _org_build_available_tasks = axr_task_manager.generate_available_tasks
        axr_task_manager.generate_available_tasks = _build_available_tasks
    end
    if not _org_get_trader_type and type(trader_autoinject) == "table"
        and type(trader_autoinject.get_trader_type) == "function" then
        _org_get_trader_type = trader_autoinject.get_trader_type
        _trader_type_by_role = {
            trader = trader_autoinject.SUPPLIER, barman = trader_autoinject.BARMAN,
            mechanic = trader_autoinject.MECHANIC, medic = trader_autoinject.MEDIC,
        }
        trader_autoinject.get_trader_type = _get_trader_type
    end
    _register_hub_gate(dialogs, "check_task_stack")
    _register_hub_gate(dialogs, "condition_actor_has_valuable_item")
    _register_hub_gate(dialogs, "actor_has_important_documents")
    _register_hub_gate(txr_routes, "check_all_routes")
    _register_hub_gate(ui_pda_npc_tab, "have_encrypted_pda")
    _load_stock_policy()
    CreateTimeEvent(TIMER_EV, SCAN_ID, SCAN_INTERVAL_SEC, _update_mutations)
    ap_core_debug.info("[MUTATOR.SMART] Initialized")
end
