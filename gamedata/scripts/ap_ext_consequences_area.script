--- ap_ext_consequences_area: CONFIGS-driven AREA consequences (area_conquer, area_swarm, area_infest).
--- All RULES + SCAN live in ap_ext_causes_area; consequences are action-only per radiant invariant 5.
--- conquer / swarm / infest: all exclusive spawn (sole ownership), independent tables. infest adds a higher count, a species allowlist, and a per-level cap.

local tostring = tostring
local xobject, xtime, xprofiler, xtrace = xobject, xtime, xprofiler, xtrace
local ap_core_debug, ap_core_broker, ap_core_record, ap_core_consumer = ap_core_debug, ap_core_broker, ap_core_record, ap_core_consumer
local ap_ext_tracker, ap_ext_smart_mutator = ap_ext_tracker, ap_ext_smart_mutator

local RESULT = ap_core_const.RESULT
local REASON = ap_core_const.REASON
local CAUSE = ap_core_const.CAUSE
local CAUSE_CATEGORY = ap_core_const.CAUSE_CATEGORY
local CONSEQUENCE = ap_core_const.CONSEQUENCE
local ACTION = ap_core_const.ACTION
local PRE_RELEASE_GULAG = ap_core_const.PRE_RELEASE_GULAG

local LOG = ap_core_debug.bracket(CAUSE_CATEGORY.OPPORTUNITIES)

local cfg = ap_core_mcm.cfg

local function _on_arrive_conquer(squad, args)
    if not args then return end
    local dbg = ap_core_debug.enabled()
    local tid = dbg and xtrace.new().id or 0
    local tmr = xprofiler.new_if(dbg):start()
    ap_ext_tracker.reset_squad_opportunity(squad.id, args.dto_field, xtime.game_sec())
    ap_ext_smart_mutator.conquer_smart(args.target_smart_id, args.identity, args.level_id)
    tmr:stop()
    if dbg then
        ap_core_debug.debug("%s [tid=%d] arrive conquer smart=%d identity=%s [%.2fms]", LOG, tid,
            args.target_smart_id, tostring(args.identity), tmr:get_ms())
    end
end

local function _on_arrive_swarm(squad, args)
    if not args then return end
    local dbg = ap_core_debug.enabled()
    local tid = dbg and xtrace.new().id or 0
    local tmr = xprofiler.new_if(dbg):start()
    ap_ext_tracker.reset_squad_opportunity(squad.id, args.dto_field, xtime.game_sec())
    ap_ext_smart_mutator.swarm_smart(args.target_smart_id, args.identity, args.level_id)
    tmr:stop()
    if dbg then
        ap_core_debug.debug("%s [tid=%d] arrive swarm smart=%d species=%s [%.2fms]", LOG, tid,
            args.target_smart_id, tostring(args.identity), tmr:get_ms())
    end
end

local function _on_arrive_infest(squad, args)
    if not args then return end
    local dbg = ap_core_debug.enabled()
    local tid = dbg and xtrace.new().id or 0
    local tmr = xprofiler.new_if(dbg):start()
    ap_ext_tracker.reset_squad_opportunity(squad.id, args.dto_field, xtime.game_sec())
    ap_ext_smart_mutator.infest_smart(args.target_smart_id, args.species, args.level_id)
    tmr:stop()
    if dbg then
        ap_core_debug.debug("%s [tid=%d] arrive infest smart=%d species=%s [%.2fms]", LOG, tid,
            args.target_smart_id, tostring(args.species), tmr:get_ms())
    end
end

local CONFIGS = {
    { event = CAUSE.AREA_CONQUER, consequence = CONSEQUENCE.AREA_CONQUER, action = ACTION.AREA_CONQUER, name = "area_conquer",
        pre_release_gulag = PRE_RELEASE_GULAG.AREA_CONQUER, on_arrive = _on_arrive_conquer },
    { event = CAUSE.AREA_SWARM, consequence = CONSEQUENCE.AREA_SWARM, action = ACTION.AREA_SWARM, name = "area_swarm",
        pre_release_gulag = PRE_RELEASE_GULAG.AREA_SWARM, on_arrive = _on_arrive_swarm },
    { event = CAUSE.AREA_INFEST, consequence = CONSEQUENCE.AREA_INFEST, action = ACTION.AREA_INFEST, name = "area_infest",
        pre_release_gulag = PRE_RELEASE_GULAG.AREA_INFEST, on_arrive = _on_arrive_infest },
}

local function _make_condition(enabled_key)
    return function() return cfg[enabled_key] end
end

local function _make_handler(entry)
    return function(event_data)
        local dbg = ap_core_debug.enabled()
        local tid = event_data.tid or 0
        local squad = xobject.se(event_data.squad_id)
        if not squad then return { code = RESULT.FAILED_SCAN, reason = REASON.NO_SQUAD } end
        local smart = xobject.se(event_data.dst_smart_id)
        if not smart then return { code = RESULT.FAILED_SCAN, reason = REASON.NO_SMART } end

        local tmr = xprofiler.new_if(dbg):start()
        local res = ap_core_broker.script_squad(squad, smart, {
            rush = cfg["consequence_" .. entry.name .. "_rush"],
            on_arrive = entry.consequence,
            on_arrive_args = {
                target_smart_id = smart.id,
                identity = event_data.identity,
                species = event_data.species,
                level_id = event_data.level_id,
                dto_field = event_data.dto_field,
            },
            pre_release_gulag = entry.pre_release_gulag,
            interruptable = false,
        })
        tmr:stop()
        local ok = res.code == RESULT.SUCCESS
        if dbg then
            ap_core_debug.debug("%s [tid=%d] %s dst=%d [%.2fms]", entry.log_prefix, tid,
                ok and RESULT.SUCCESS or (RESULT.FAILED_ACTION .. ":" .. (res.reason or REASON.MOVE_FAILED)), smart.id, tmr:get_ms())
        end
        if not ok then return { code = RESULT.FAILED_ACTION, reason = res.reason or REASON.MOVE_FAILED } end
        ap_core_record.add_record(squad, event_data.cause, entry.consequence, {
            action_key = entry.action,
            smart = smart, level_id = event_data.level_id,
        })
        return { code = RESULT.SUCCESS }
    end
end

function on_game_start()
    for i = 1, #CONFIGS do
        CONFIGS[i].log_prefix = ap_core_debug.bracket(CONFIGS[i].consequence)
    end
    for i = 1, #CONFIGS do
        local entry = CONFIGS[i]
        local enabled_key = "consequence_" .. entry.name .. "_enabled"
        ap_core_consumer.register(entry.consequence, {
            event = entry.event,
            condition = _make_condition(enabled_key),
            on_arrive = entry.on_arrive,
        }, _make_handler(entry))
    end
    ap_core_debug.info(LOG .. " Initialized: %d consequences", #CONFIGS)
end
